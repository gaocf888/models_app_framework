# =============================================================================
# MIS-TEI 环境变量模板（复制为 mis-tei-deploy/.env）
# 镜像：swr.cn-south-1.myhuaweicloud.com/ascendhub/mis-tei:26.0.0-310p-ubuntu22.04-py3.11
# =============================================================================

MIS_TEI_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/mis-tei:26.0.0-310p-ubuntu22.04-py3.11
ASCEND_DOCKER_RUNTIME=ascend
MIS_TEI_NETWORK_NAME=mis-tei-stack

# ---------- Embedding 服务 ----------
MIS_TEI_EMBED_CONTAINER_NAME=mis-tei-embed
MIS_TEI_EMBED_HOST_PORT=8091
# 物理 NPU（与 vLLM 0-3、MinerU 6 错开；容器内 TEI_NPU_DEVICE 一般为 0）
MIS_TEI_EMBED_ASCEND_DEVICES=4
MIS_TEI_EMBED_TEI_NPU_DEVICE=0
# 宿主机模型根目录：其下须有 bge-large-zh-v1.5/（首次启动可能写入 model.safetensors，compose 以 rw 挂载）
MIS_TEI_EMBED_MODELS_HOST_PATH=/aidata/models/embeddings
# 26.0.0：--model-id 推荐容器内本地路径（离线）；亦可 ModelScope/HF id，如 BAAI/bge-large-zh-v1.5
MIS_TEI_EMBED_MODEL_ID=/home/HwHiAiUser/model/bge-large-zh-v1.5
MIS_TEI_EMBED_SERVED_NAME=bge-large-zh-v1.5
MIS_TEI_EMBED_MEM_LIMIT=16g

# ---------- Rerank 服务 ----------
MIS_TEI_RERANK_CONTAINER_NAME=mis-tei-rerank
MIS_TEI_RERANK_HOST_PORT=8092
MIS_TEI_RERANK_ASCEND_DEVICES=5
MIS_TEI_RERANK_TEI_NPU_DEVICE=0
# 宿主机模型根目录：其下须有 bge-reranker-large/
MIS_TEI_RERANK_MODELS_HOST_PATH=/aidata/models/reranker
MIS_TEI_RERANK_MODEL_ID=/home/HwHiAiUser/model/bge-reranker-large
MIS_TEI_RERANK_SERVED_NAME=bge-reranker-large
# bge-reranker-large 加载/warmup 峰值较高；若日志出现 Killed 再加大或去掉 mem_limit
MIS_TEI_RERANK_MEM_LIMIT=32g

# BERT 类加速（官方 ENABLE_BOOST）
MIS_TEI_ENABLE_BOOST=True
