# =============================================================================
# 昇腾（Ascend）MinerU GPU 镜像
# =============================================================================
# 底座与 vLLM / app 统一：
#   quay.io/ascend/vllm-ascend:v0.23.0-310p（CANN 9.1.0 + Python 3.12 + torch_npu）
# 不安装 CUDA torch；mineru 装到「带 torch」的厂商 Python，并校验 torch_npu 仍在。
# 勿 apt 安装 python3-pip（会抢 PATH，导致 ModuleNotFoundError / 丢失 torch_npu）。
# =============================================================================

ARG BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0-310p
FROM ${BASE_IMAGE}

ARG MINERU_PIP_SPEC=mineru[core]
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/usr/local/python3.12.13/bin:/usr/local/python3.11.13/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends \
        curl tini \
        libxcb1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 libgl1 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# 探测 python3.11.* / python3.12.*；构建机无 NPU 时关闭 torch_npu 自动加载
RUN set -eux; \
    if [ -f /usr/local/Ascend/ascend-toolkit/set_env.sh ]; then \
      . /usr/local/Ascend/ascend-toolkit/set_env.sh; \
    fi; \
    PY=""; \
    shopt -s nullglob; \
    CANDIDATES=(/usr/local/python3.*/bin/python3 /usr/local/bin/python3); \
    if command -v python3 >/dev/null 2>&1; then \
      CANDIDATES+=("$(command -v python3)"); \
    fi; \
    for hit in "${CANDIDATES[@]}"; do \
      if [ -x "$hit" ] && TORCH_DEVICE_BACKEND_AUTOLOAD=0 "$hit" -c "import torch" >/dev/null 2>&1; then \
        PY="$hit"; \
        break; \
      fi; \
    done; \
    if [ -z "$PY" ]; then \
      echo "ERROR: no Ascend python with torch found"; \
      echo "PATH=$PATH"; \
      ls -la /usr/local/python3.*/bin/ 2>/dev/null || true; \
      command -v python3 || true; \
      exit 1; \
    fi; \
    echo "Using PYTHON=$PY"; \
    PY_BIN="$(dirname "$PY")"; \
    echo "export PATH=${PY_BIN}:\$PATH" > /etc/profile.d/ascend-python.sh; \
    printf '%s\n' "$PY_BIN" > /etc/ascend-python-bindir; \
    ln -sfn "$PY" /usr/local/bin/python3; \
    ln -sfn "$PY" /usr/local/bin/python; \
    "$PY" -m pip install --upgrade pip setuptools wheel --default-timeout=600 --retries=20 --index-url "${PIP_INDEX_URL}" \
      || "$PY" -m pip install --upgrade pip setuptools wheel --default-timeout=600 --retries=20 --index-url "https://pypi.org/simple"; \
    if [ -n "${PIP_INDEX_URL}" ]; then \
      "$PY" -m pip install --index-url "${PIP_INDEX_URL}" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20 \
      || "$PY" -m pip install --index-url "https://pypi.org/simple" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20; \
    else \
      "$PY" -m pip install --index-url "https://pypi.org/simple" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20; \
    fi; \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 "$PY" -c "import importlib.util as u; assert u.find_spec('torch_npu') is not None, 'torch_npu missing after mineru install'"; \
    if [ -x "${PY_BIN}/mineru-api" ]; then ln -sfn "${PY_BIN}/mineru-api" /usr/local/bin/mineru-api; fi

COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/sh", "/entrypoint.sh"]
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
