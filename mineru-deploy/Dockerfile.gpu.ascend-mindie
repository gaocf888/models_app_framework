# =============================================================================
# 昇腾 MindIE 底座 · MinerU GPU 镜像（300I Duo / 310P 试验栈）
# =============================================================================
# 底座：quay.io/ascend/mindie:1.0.RC2-300I-Duo-aarch64
# 与 Dockerfile.gpu.ascend（vllm-ascend CANN 9.1）并列，互不替换。
#
# 注意：
# - MindIE 镜像侧重 LLM 推理套件；本文件仍按「厂商 Python + torch/torch_npu 上装 mineru」路径构建。
# - 构建机通常无 NPU：探测/校验时使用 TORCH_DEVICE_BACKEND_AUTOLOAD=0。
# - 勿 apt 安装 python3-pip（易抢 PATH / 破坏厂商 torch 栈）。
# - 宿主 HDK/驱动须与 MindIE 镜像内 CANN 版本匹配，否则运行期仍会算子/驱动失败。
# =============================================================================

ARG BASE_IMAGE=quay.io/ascend/mindie:1.0.RC2-300I-Duo-aarch64
FROM ${BASE_IMAGE}

ARG MINERU_PIP_SPEC=mineru[core]
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/usr/local/python3.10.0/bin:/usr/local/python3.10/bin:/usr/local/python3.11.13/bin:/usr/local/python3.12.13/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates tini \
        libxcb1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 libgl1 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# 加载 MindIE / CANN 环境后探测「带 torch（优先 torch_npu）」的 Python
RUN set -eux; \
    for envf in \
      /usr/local/Ascend/ascend-toolkit/set_env.sh \
      /usr/local/Ascend/nnal/atb/set_env.sh \
      /usr/local/Ascend/mindie/set_env.sh \
      /usr/local/Ascend/llm_model/set_env.sh \
      /usr/local/Ascend/mindformers/set_env.sh; do \
      if [ -f "$envf" ]; then . "$envf"; fi; \
    done; \
    PY=""; \
    PY_FALLBACK=""; \
    shopt -s nullglob; \
    CANDIDATES=( \
      /usr/local/python3.*/bin/python3 \
      /usr/local/bin/python3 \
      /opt/conda/bin/python3 \
      /root/miniconda3/bin/python3 \
      /home/*/miniconda*/bin/python3 \
    ); \
    if command -v python3 >/dev/null 2>&1; then \
      CANDIDATES+=("$(command -v python3)"); \
    fi; \
    if command -v python >/dev/null 2>&1; then \
      CANDIDATES+=("$(command -v python)"); \
    fi; \
    for hit in "${CANDIDATES[@]}"; do \
      [ -x "$hit" ] || continue; \
      if TORCH_DEVICE_BACKEND_AUTOLOAD=0 "$hit" -c "import torch" >/dev/null 2>&1; then \
        if TORCH_DEVICE_BACKEND_AUTOLOAD=0 "$hit" -c "import torch_npu" >/dev/null 2>&1; then \
          PY="$hit"; \
          break; \
        fi; \
        if [ -z "$PY_FALLBACK" ]; then PY_FALLBACK="$hit"; fi; \
      fi; \
    done; \
    if [ -z "$PY" ]; then PY="$PY_FALLBACK"; fi; \
    if [ -z "$PY" ]; then \
      echo "ERROR: MindIE image has no Python with torch (need torch/torch_npu for MinerU)"; \
      echo "PATH=$PATH"; \
      ls -la /usr/local/python3.*/bin/ 2>/dev/null || true; \
      command -v python3 || true; \
      command -v python || true; \
      exit 1; \
    fi; \
    echo "Using PYTHON=$PY"; \
    "$PY" -c "import sys; print('python', sys.version)"; \
    PY_BIN="$(dirname "$PY")"; \
    echo "export PATH=${PY_BIN}:\$PATH" > /etc/profile.d/ascend-python.sh; \
    printf '%s\n' "$PY_BIN" > /etc/ascend-python-bindir; \
    ln -sfn "$PY" /usr/local/bin/python3; \
    ln -sfn "$PY" /usr/local/bin/python; \
    "$PY" -m pip install --upgrade pip setuptools wheel --default-timeout=600 --retries=20 --index-url "${PIP_INDEX_URL}" \
      || "$PY" -m pip install --upgrade pip setuptools wheel --default-timeout=600 --retries=20 --index-url "https://pypi.org/simple"; \
    if [ -n "${PIP_INDEX_URL}" ]; then \
      "$PY" -m pip install --index-url "${PIP_INDEX_URL}" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20 \
      || "$PY" -m pip install --index-url "https://pypi.org/simple" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20; \
    else \
      "$PY" -m pip install --index-url "https://pypi.org/simple" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20; \
    fi; \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 "$PY" -c "import importlib.util as u; assert u.find_spec('torch') is not None, 'torch missing after mineru install'"; \
    if ! TORCH_DEVICE_BACKEND_AUTOLOAD=0 "$PY" -c "import importlib.util as u; assert u.find_spec('torch_npu') is not None" >/dev/null 2>&1; then \
      echo "WARNING: torch_npu missing after mineru install; NPU device mode may fail at runtime"; \
    fi; \
    if [ -x "${PY_BIN}/mineru-api" ]; then ln -sfn "${PY_BIN}/mineru-api" /usr/local/bin/mineru-api; fi; \
    command -v mineru-api || ls -la "${PY_BIN}/mineru-api" || true

COPY docker/entrypoint.ascend-mindie.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

WORKDIR /workspace
# tini 若因基础镜像无 apt 而未装上，回退为直接 sh
ENTRYPOINT ["/bin/sh", "-c", "if [ -x /usr/bin/tini ]; then exec /usr/bin/tini -- /bin/sh /entrypoint.sh \"$@\"; else exec /bin/sh /entrypoint.sh \"$@\"; fi", "--"]
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
