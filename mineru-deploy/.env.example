# ---------- 关键配置项说明（针对gpu模式的关键配置项，cpu模式无关键配置项） ----------
# 1. MINERU_DEVICE_MODE: mineru运行设备模式（英伟达：cuda  华为晟腾：npu）
# 2. *_VISIBLE_DEVICES: 运行可见设备(英伟达只有一张卡，所以配置为0；华为晟腾双芯前两个卡(0,1,2,3)用于部署vLLM，第三张卡(4,5)用于部署app的嵌入和重排模型，第四张卡的第一个芯(6)部署mineru)
# 3. INSTALL_CUDA_TORCH: 是否安装torch(只有英伟达环境需要安装torch(配置1)；其他国产卡默认镜像中已安装适配版torch,禁止安装torch)
# 4. MINERU_MODELS_HOST_PATH: 本地模型路径 （非必须修改，默认即可）
# 5. MINERU_IO_HOST_PATH: mineru IO本地挂载路径 （非必须修改，默认即可）

# =============================================================================
# MinerU 环境变量模板（复制为 mineru-deploy/.env 后按需修改）
# =============================================================================
#
# 【显卡平台选型】
# | 平台     | compose 文件                    | 基础镜像 / 设备变量                          |
# |----------|---------------------------------|----------------------------------------------|
# | 英伟达   | docker-compose.gpu.yml          | MINERU_BASE_IMAGE=nvidia/cuda:...            |
# |          |                                 | MINERU_DEVICE_MODE=cuda                      |
# |          |                                 | MINERU_NVIDIA_VISIBLE_DEVICES=0              |
# | 昇腾     | docker-compose.gpu.ascend.yml   | 默认底座 v0.23.0-310p（CANN 9.1.0，与 vLLM/app 一致） |
# |          |                                 | MINERU_DEVICE_MODE=npu                       |
# |          |                                 | ASCEND_RT_VISIBLE_DEVICES=6（§5 独占卡3）    |
# | CPU      | docker-compose.cpu.yml          | 无加速卡；功能保底                           |
# | 沐曦     | （当前沐曦使用cpu部署，若后续新增gpu compose）          | 对齐厂商镜像 + 对应可见设备变量              |
#
# =============================================================================

# ---------- 镜像名 ----------
MINERU_CPU_IMAGE=mineru-cpu:py311
MINERU_GPU_IMAGE=mineru-gpu:cu124-cudnn-fix
MINERU_ASCEND_IMAGE=mineru-gpu:ascend-310p

# ---------- 英伟达 GPU 构建（docker-compose.gpu.yml）----------
# MINERU_BASE_IMAGE=nvidia/cuda:12.3.2-runtime-ubuntu22.04
# MINERU_DEVICE_MODE=cuda
# MINERU_NVIDIA_VISIBLE_DEVICES=0
# INSTALL_CUDA_TORCH=1
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
# TORCH_VERSION=2.5.1
# TORCHVISION_VERSION=0.20.1

# ---------- 昇腾 Ascend 构建（docker-compose.gpu.ascend.yml · 地面沉降默认）----------
# 与 vLLM / app 同底座；宿主机须 HDK 26.1.1 + 固件 9.0.0.9.220 + Runtime 26.1.0
# tags：https://quay.io/repository/ascend/vllm-ascend?tab=tags
MINERU_BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0-310p
MINERU_DEVICE_MODE=npu
# 四卡切分：MinerU 用设备 6（物理卡3）；勿与 vLLM(0,1,2,3) / app(4,5) 重叠
ASCEND_RT_VISIBLE_DEVICES=6
# ASCEND_DOCKER_RUNTIME=ascend
# 昇腾栈勿装 CUDA torch
INSTALL_CUDA_TORCH=0

MINERU_CPU_PIP_SPEC=mineru[core]
MINERU_GPU_PIP_SPEC=mineru[core]
# Optional pip mirror:
# PIP_INDEX_URL=https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------- 运行期公共 ----------
MINERU_CONTAINER_NAME=mineru-api
MINERU_PORT=8009

# Host paths (must exist)
MINERU_MODELS_HOST_PATH=/aidata/mineru/models
MINERU_IO_HOST_PATH=/aidata/mineru/io

# Online by default
# MINERU_MODEL_SOURCE=modelscope
# HF_HUB_OFFLINE=0
# TRANSFORMERS_OFFLINE=0

# Offline fallback:
MINERU_MODEL_SOURCE=local
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# local 模式必填：models-dir 映射（容器内路径，见 config/mineru.json）
# MINERU_TOOLS_CONFIG_JSON=/config/mineru.json
# MINERU_CONFIG_HOST_PATH=./config/mineru.json

# Resources
MINERU_CPU_LIMIT=12.0
MINERU_MEM_LIMIT=32g
# 线程数硬限制（避免 64 核机器被单任务打满）
OMP_NUM_THREADS=10
MKL_NUM_THREADS=10
OPENBLAS_NUM_THREADS=10
NUMEXPR_NUM_THREADS=10
TORCH_NUM_THREADS=10
TORCH_NUM_INTEROP_THREADS=2

# Network (must match models-app external network)
MINERU_NETWORK_NAME=mineru-stack
