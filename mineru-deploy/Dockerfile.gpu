# 与 vllm-deploy 英伟达栈对齐；GPU 推理须 cudnn-runtime（纯 runtime 易 Layout Conv2d 报 CUDNN_STATUS_NOT_INITIALIZED）
# PyTorch 固定 cu124 wheel，避免 mineru[core] 依赖把它升到 cu130 导致驱动不兼容
ARG BASE_IMAGE=nvidia/cuda:12.3.0-cudnn-runtime-ubuntu22.04
FROM ${BASE_IMAGE}

ARG MINERU_PIP_SPEC=mineru[core]
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG INSTALL_CUDA_TORCH=1
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG TORCH_VERSION=2.5.1
ARG TORCHVISION_VERSION=0.20.1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 python3-pip python3-venv python3-setuptools python3-wheel \
       curl tini \
       libxcb1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel --default-timeout=600 --retries=20 --index-url "${PIP_INDEX_URL}" \
    || python3 -m pip install --upgrade pip setuptools wheel --default-timeout=600 --retries=20 --index-url "https://pypi.org/simple"
RUN if [ "${INSTALL_CUDA_TORCH}" = "1" ]; then \
      python3 -m pip install --index-url "${TORCH_INDEX_URL}" \
        "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}" --default-timeout=600 --retries=20; \
    fi
RUN if [ -n "${PIP_INDEX_URL}" ]; then \
      python3 -m pip install --index-url "${PIP_INDEX_URL}" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20 \
      || python3 -m pip install --index-url "https://pypi.org/simple" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20; \
    else \
      python3 -m pip install --index-url "https://pypi.org/simple" "${MINERU_PIP_SPEC}" --default-timeout=600 --retries=20; \
    fi
# mineru[core] 可能升级 torch/torchvision；安装后强制回装 pin 版本（须 torch+torchvision 成对匹配）
RUN if [ "${INSTALL_CUDA_TORCH}" = "1" ]; then \
      python3 -m pip install --index-url "${TORCH_INDEX_URL}" \
        "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}" \
        --force-reinstall --no-deps --default-timeout=600 --retries=20 \
      && python3 -c "import torch, torchvision; \
         tv=torch.__version__; vv=torchvision.__version__; c=torch.version.cuda; \
         assert 'cu130' not in tv and c != '13.0', f'unexpected torch {tv} cuda {c}'; \
         assert tv.startswith('${TORCH_VERSION}'), f'unexpected torch {tv}'; \
         assert vv.startswith('${TORCHVISION_VERSION}'), f'unexpected torchvision {vv}'; \
         import torchvision.ops; \
         print(f'pinned torch {tv} torchvision {vv} cuda {c}')"; \
    fi
# 构建期无法访问 GPU；仅校验 cuDNN 库可被 torch 加载（需 nvidia/cuda:*-cudnn-runtime 基础镜像）
RUN if [ "${INSTALL_CUDA_TORCH}" = "1" ]; then \
      python3 -c "import torch; assert torch.backends.cudnn.is_available(), 'cudnn not available'; \
         print('cudnn version', torch.backends.cudnn.version())"; \
    fi

COPY docker/entrypoint.sh /entrypoint.sh
# Windows 检出常为 CRLF，会导致 shebang 变成 sh\r；构建时统一为 LF，并由 sh 显式执行
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/sh", "/entrypoint.sh"]
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
