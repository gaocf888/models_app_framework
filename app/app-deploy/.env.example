# ---------- 关键配置项说明 ----------
# 1. LLM_DEFAULT_MODEL: 大模型  <与 vLLM served_model_name 一致>
# 2. EMBEDDING_DEVICE: 嵌入模型部署设备
# 3. RAG_RERANKER_DEVICE: 重排模型部署设备
# 4. ASCEND_RT_VISIBLE_DEVICES: 加速卡可见设备

# =============================================================================
# 应用部署环境变量模板（请复制为同目录 .env 再修改）
# =============================================================================
#
# 【重要】两套消费者 · 配置时不要混用语义
#
#   (1) Docker Compose 在「宿主机」解析（写进 docker-compose.yml 的 ${VAR}）
#       仅影响 compose 本身：端口映射、external 网络名、数据卷源路径、
#       models-app-gpu 的 NVIDIA_VISIBLE_DEVICES 注入值 等。
#       见本文件末尾「━━ Compose 专用 ━━」段。
#
#   (2) 应用进程在「容器内」读取（app/core/config.py 的 os.getenv）
#       通过 compose 的 env_file 整文件注入，应用不会自行 load_dotenv 读磁盘。
#       密钥、LLM/RAG/DB 等均以容器内环境为准。
#
# 【策略】
#   - 开发：本目录一份 .env，勿提交真实密码。
#   - 生产：用 CI/Secret 注入相同键名，或挂载只读 env；与 EasySearch、vLLM 侧配置保持一致。
#   - 与 rag_db-deploy 对齐：RAG_ES_* 与 project-env/rag-es.env.example、库侧账号一致。
#
# =============================================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 入口与并发（由 config.py / uvicorn 使用）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用部署环境标记（当前仅作为配置元数据，代码未做 dev/prod 分支逻辑）
APP_ENV=prod
# Uvicorn worker 数量；docker-compose 内 command 使用 UVICORN_WORKERS
UVICORN_WORKERS=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 日志
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# INFO/DEBUG
LOG_LEVEL=INFO
LOG_JSON=false
# stdout 日志（Docker logs）保持启用；以下参数用于额外开启应用内部文件日志（按大小轮转）
LOG_FILE_ENABLED=true
# 默认文件路径（容器内）；开启 LOG_FILE_ENABLED=true 时生效
LOG_FILE=/workspace/logs/app.log
# 单个日志文件最大字节数（默认 100MB）
LOG_FILE_MAX_BYTES=104857600
# 保留的历史文件数（不含当前 app.log）
LOG_FILE_BACKUP_COUNT=10
# 轮转后的历史日志是否 gzip 压缩
LOG_FILE_COMPRESS=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 鉴权（Service API Key，对方后台调用算法接口时使用）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 请求头：Authorization: Bearer <密钥>；支持轮换：逗号分隔多个等效密钥（任一匹配即可）。
#
# 【生成密钥】在仓库根目录用 Python 调用 app/auth/keygen.py 中的 generate_service_api_key（勿提交真实值到 Git）：
#   Linux/macOS: PYTHONPATH=. python -c "from app.auth.keygen import generate_service_api_key; print(generate_service_api_key())"
#   Win PS:       $env:PYTHONPATH=(Get-Location).Path; python -c "from app.auth.keygen import generate_service_api_key; print(generate_service_api_key())"
# 部署与轮换说明：同目录 README.md、README-simple-deploy.md「Service API Key」小节。
# 认证与安全总述：仓库内 docs/Service-API-Key-认证与安全说明.md
# 支持配置多个 API key：英文逗号分隔（请求携带的密钥与下列任一项一致即可通过）。
SERVICE_API_KEYS=WOeJlenXrXN-CjjBEnGElXtnH0JY2h-i5tt7XIAa4iM,kCRA4fZs72cqc9C_oznxn_HWUeT-CDf1MP2uHvr_ihQ
# 单密钥时可改用：SERVICE_API_KEY=...

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 大模型（统一指向 vllm-deploy，OpenAI 兼容 /v1）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 必须使用「容器间」可解析主机名：默认 vllm-service，勿用 127.0.0.1 指宿主机上的 vLLM
# LLM_DEFAULT_MODEL=qwen2.5-14b-instruct-awq
# LLM_DEFAULT_MODEL=qwen3-8b
# LLM_DEFAULT_MODEL=qwen3.6-27b-w8a8
LLM_DEFAULT_MODEL=qwen3-14b
# OpenAI 兼容根路径（结尾保留 /v1）
LLM_DEFAULT_ENDPOINT=http://vllm-service:8000/v1
# 若 vLLM 开启 API Key，在此配置；未启用可留空
LLM_DEFAULT_API_KEY=
# 若 vLLM 启用了 api-key，在此与 vLLM 侧填相同值

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · EasySearch / RAG（与 rag_db-deploy、HTTPS/TLS 策略一致）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RAG_VECTOR_STORE_TYPE=es
# 可配置多个主机，逗号分隔，如：https://rag-easysearch:9200,https://rag-es-backup:9200
RAG_ES_HOSTS=https://rag-easysearch:9200
# EasySearch 账号（与 rag_db-deploy/.env 保持一致）
RAG_ES_USERNAME=admin
# EasySearch 密码（与 rag_db-deploy/.env 保持一致）
RAG_ES_PASSWORD=ChangeMe_123!
# 若使用 API Key，可替代账号密码；留空表示不用
RAG_ES_API_KEY=
# 自建证书 / 内网 HTTPS 时常为 false；公网受信 CA 可改为 true
RAG_ES_VERIFY_CERTS=false
# ES/EasySearch 请求超时（秒）
RAG_ES_REQUEST_TIMEOUT=30


# 主知识库别名（逻辑索引名，应用检索和知识摄入走该 alias）
RAG_ES_INDEX_ALIAS=rag_knowledge_base
# RAG_ES_INDEX_NAME + RAG_ES_INDEX_VERSION（物理索引名，首次应用部署RAG_ES_INDEX_VERSION配置1即可(rag_knowledge_base_v1)，若后续迭代索引结构变化，配置为2，结合RAG_ES_AUTO_MIGRATE_ON_START=true，应用重启会重新创建新的物理索引rag_knowledge_base_v2）
# 主知识库索引（chunks）
RAG_ES_INDEX_NAME=rag_knowledge_base
# 索引版本号（用于迁移）
RAG_ES_INDEX_VERSION=2
# 启动时是否自动检查并迁移索引版本
RAG_ES_AUTO_MIGRATE_ON_START=true
# 向量字段名（需与摄入/查询逻辑一致）
RAG_ES_VECTOR_FIELD=embedding
# hybrid RAG 关键词臂：避免 ES match 超出 Lucene maxClauseCount（1024）。仅截字符不够时还可限制词数/密文长度。
# 向量语义检索仍使用完整问句；下列仅作用于 keyword/metadata 的 match。
# RAG_ES_MATCH_QUERY_MAX_CHARS=2400
# RAG_ES_MATCH_QUERY_MAX_TERMS=120
# RAG_ES_MATCH_QUERY_MAX_DENSE_CHARS=128
RAG_ES_MATCH_QUERY_MAX_CHARS=512
RAG_ES_MATCH_QUERY_MAX_TERMS=24
RAG_ES_MATCH_QUERY_MAX_DENSE_CHARS=48
# NL2SQL Hybrid 第三路 metadata 使用短固定查询（勿传整段 plan 问句，避免 ES maxClauseCount）
# NL2SQL_HYBRID_METADATA_QUERY=nl2sql_system_feedback_v1
# 文档元信息索引（文档级状态、来源、版本等）
RAG_ES_DOCS_INDEX_NAME=rag_docs
RAG_ES_DOCS_INDEX_ALIAS=rag_docs_current
RAG_ES_DOCS_INDEX_VERSION=1
# 异步作业索引（摄入任务、状态追踪等） -- 摄入任务状态ES库中通过索引持久化，实现断点续跑
# rag_jobs_v1/rag_jobs_v2
RAG_ES_JOBS_INDEX_NAME=rag_jobs
RAG_ES_JOBS_INDEX_ALIAS=rag_jobs_current
# v2：metrics/documents 改 JSON 文本存储，避免 ES total_fields 3000 上限；升级后重启应用自动建新索引（新项目部署可以配置为1，因当前之前配置为v1的索引的字段已超3000个，所以当前项目中配置新的v2）
RAG_ES_JOBS_INDEX_VERSION=2

# ---------- RAG 知识库图块摄入和召回实现（figure） 实现文搜图----------
# 摄入：知识文档中图形/图纸抽取、调用VLM生成图形描述、图形描述+前后文本向量存储、对应元数据存储增加图形url(minIO存储)
# 召回：用户query语义+关键字召回，召回的图形知识片段 对应的元数据中含有图形url，前端即可通过url加载图形
# 清洗：从解析文本中剥离内嵌 HTML（html源码，table/div 等）；启发式跳过无 HTML 标签的文本（如「温度<500℃」）
RAG_CLEAN_STRIP_HTML=true

# 总开关：false=不存图、不 VLM、不扩展(原来纯文本向量存储和召回)；true=完整 figure 管线(上述摄入和召回逻辑) -- 开启后因知识摄入过程中会调用 VLM进行分析，所以摄入耗时会较多
RAG_FIGURE_ENABLED=true
# 知识库图片 bucket（与 CHATBOT_IMAGE_MINIO_BUCKET 分离）
RAG_FIGURE_MINIO_BUCKET=rag-assets
# VLM 生成图描述
RAG_FIGURE_CAPTION_PROMPT_VERSION=rag_figure_caption_v1
RAG_FIGURE_CAPTION_MAX_TOKENS=2048
RAG_FIGURE_CAPTION_TEMPERATURE=0.2
# MinIO 对象路径与链接有效期
RAG_FIGURE_OBJECT_KEY_PREFIX=rag-assets/
RAG_FIGURE_PRESIGN_TTL_SECONDS=86400
# 缓解2（摄入）：图前/图后正文拼入 figure chunk
RAG_FIGURE_NEIGHBOR_TEXT_MAX_CHARS=400
RAG_FIGURE_NEIGHBOR_TEXT_BEFORE_RATIO=0.7
# 缓解1（召回）：正文命中后扩展关联 figure
RAG_FIGURE_EXPAND_MAX_PER_TEXT=2
RAG_FIGURE_EXPAND_MAX_TOTAL=6
# 知识原文对象存储前缀（与 figure 前缀分开；同一 RAG_FIGURE_MINIO_BUCKET）
RAG_ORIGINAL_OBJECT_KEY_PREFIX=rag-docs/
# 管理台上传未传 dataset_id 时的默认值
RAG_DEFAULT_DATASET_ID=default
# true：jobs/ingest、upsert、move 目标 namespace 禁止为空（上传接口始终要求非空）。地降所建议 true
RAG_REQUIRE_NAMESPACE=true
# 查询侧多模态增强（阶段 4，与 RAG_FIGURE_ENABLED 独立）
RAG_QUERY_VISION_AUGMENT_ENABLED=false
# vision_augmented（VLM 描述附图后检索）| hybrid（原 query + 增强 query 双路合并）
RAG_QUERY_VISION_AUGMENT_MODE=vision_augmented

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · Redis 会话（compose 服务名 redis，勿写成 127.0.0.1）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 方案A持久化摄入队列同样依赖 REDIS_URL；若留空将退化为进程内线程执行（重启不可续跑）。
REDIS_URL=redis://redis:6379/0
# 会话过期时间（分钟），0 或负数可视为不过期（按代码实现）[redis 会话热存储7天(10080分钟)]
CONV_SESSION_TTL_MINUTES=10080
# 单会话最大保留消息数（超出会裁剪历史）
CONV_MAX_HISTORY_MESSAGES=50
# GET /chatbot/sessions/messages 单次最多返回消息条数（导出/历史）
CONV_EXPORT_MAX_MESSAGES=500
# GET /chatbot/sessions 每页条数默认与硬顶（1~200）
CONV_SESSION_LIST_MAX=50
# 会话列表标题：off=仅用预览/session_id；truncate=首条 user 截断；llm=预留（当前与 truncate 相同）
CHATBOT_SESSION_TITLE_MODE=truncate
# 用户 PATCH 修改标题时的最大码位长度（默认 64，上限 200）
# CHATBOT_SESSION_TITLE_EDIT_MAX_RUNES=64
# 截断标题最大字符数（Unicode 码位）
CHATBOT_SESSION_TITLE_MAX_RUNES=28
# user_id / session_id：默认禁止 ':' 与控制字符（见 app/conversation/ids.py）；遗留 ID 可设 CONV_ID_STRICT=false
CONV_ID_STRICT=true
CONV_USER_ID_MAX_LEN=128
CONV_SESSION_ID_MAX_LEN=256
# Redis 写入后阻塞等待落盘（毫秒，0=仅异步）；生产可设 300~2000 以降低「写完立刻读」竞态
CONV_REDIS_APPEND_WAIT_MS=0
# Redis 客户端超时与健康检查（秒）；HEALTH_CHECK_INTERVAL=0 表示关闭（旧版 redis-py 可能不支持 interval）
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
# 会话冷层归档（EasySearch）与自动回查
# 开启后：append_* 自动写入冷层；/chatbot/sessions* 在热层不足时自动补查冷层
CONV_ARCHIVE_ENABLED=true
CONV_QUERY_FALLBACK_COLD=true
# 默认复用 RAG_ES_* 连接；如需独立归档集群可单独配置 CONV_ARCHIVE_ES_*
CONV_ARCHIVE_ES_INDEX=conversation_messages_v1
CONV_ARCHIVE_ES_SESSIONS_INDEX=conversation_sessions_v1
CONV_ARCHIVE_QUERY_MAX_LIMIT=2000
# CONV_ARCHIVE_ES_HOSTS=https://rag-easysearch:9200
# CONV_ARCHIVE_ES_USERNAME=admin
# CONV_ARCHIVE_ES_PASSWORD=ChangeMe_123!
# CONV_ARCHIVE_ES_API_KEY=
# CONV_ARCHIVE_ES_VERIFY_CERTS=false
# CONV_ARCHIVE_ES_TIMEOUT_SECONDS=10
# 对象存储备份增强（local 或 s3；默认 local）
CONV_ARCHIVE_OBJECT_ENABLED=true
CONV_ARCHIVE_OBJECT_BACKEND=local
# 须与 docker-compose 中 SESSION_STORAGE_HOST_PATH → /workspace/data/conversation_archive 一致
CONV_ARCHIVE_OBJECT_LOCAL_DIR=/workspace/data/conversation_archive
# S3 兼容对象存储（当 BACKEND=s3 且容器安装 boto3 时生效）
# CONV_ARCHIVE_OBJECT_S3_ENDPOINT=http://minio:9000
# CONV_ARCHIVE_OBJECT_S3_ACCESS_KEY=minioadmin
# CONV_ARCHIVE_OBJECT_S3_SECRET_KEY=minioadmin
# CONV_ARCHIVE_OBJECT_S3_REGION=us-east-1
# CONV_ARCHIVE_OBJECT_S3_BUCKET=conversation-archive
# CONV_ARCHIVE_OBJECT_S3_PREFIX=conversation-archive

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 智能客服 LangGraph（可选，未配置时使用代码默认值）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 对话入口仅 SSE：POST /chatbot/chat/stream（须安装 langgraph，无 Legacy / 非流式 /chat）
# 是否启用意图节点（输出 kb_qa / clarify / data_query / hybrid_qa 等，由白名单约束）
CHATBOT_INTENT_ENABLED=true
# 意图分类后端：rules（默认）| llm（规则+进程内轻量 LLM 窄触发）| bert（须微调，暂不推荐）
CHATBOT_INTENT_BACKEND=rules
# --- 轻量意图 LLM（CHATBOT_INTENT_BACKEND=llm 时生效；进程内 CPU，见 docs/智能客服意图识别轻量LLM接入说明.md）---
# 本地 HF 目录（compose 挂载）；不设则按 MODEL_NAME 从 HuggingFace 在线拉取
CHATBOT_INTENT_LLM_MODEL_PATH=/workspace/models/llm/qwen2.5-0.5b-instruct
CHATBOT_INTENT_LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
CHATBOT_INTENT_LLM_DEVICE=cuda:1
# 昇腾栈若意图 LLM 走 NPU：可改为 npu:0（相对 ASCEND_RT_VISIBLE_DEVICES）；CPU 可写 cpu
CHATBOT_INTENT_LLM_MAX_TOKENS=96
CHATBOT_INTENT_LLM_TEMPERATURE=0
# 意图识别配置为llm时，走规则+轻量llm，规则得分小于下面配置值时，会再窄触发走轻量llm（否则不走轻量llm）
CHATBOT_INTENT_LLM_CONF_THRESHOLD=0.78
CHATBOT_INTENT_LLM_FALLBACK_TO_RULES=true
# 意图节点允许输出的标签白名单（逗号分隔）；data_query 走 NL2SQL，kb_qa 走向量 RAG，hybrid_qa 双臂综合
CHATBOT_INTENT_OUTPUT_LABELS=kb_qa,clarify,data_query,hybrid_qa
# --- BERT 意图（仅 CHATBOT_INTENT_BACKEND=bert 时生效）---
# 【必读】须为已完成 kb_qa/data_query/clarify 微调并导出的 HF 序列分类目录；
# 不能直接使用魔塔/HF 通用预训练 BERT（如 bert-base-chinese）。不想训练请保持 CHATBOT_INTENT_BACKEND=rules。
# 本地微调模型目录（离线推荐）；容器内示例见 docker-compose 挂载 /workspace/models/intent/chatbot-intent-bert
# CHATBOT_INTENT_BERT_MODEL_PATH=/workspace/models/intent/chatbot-intent-bert
# 无本地路径时可填已微调的 HuggingFace 模型名（非通用预训练基座）
# CHATBOT_INTENT_BERT_MODEL_NAME=
# 推理设备：cpu | cuda | cuda:0
CHATBOT_INTENT_BERT_DEVICE=cpu
# tokenizer 最大序列长度
CHATBOT_INTENT_BERT_MAX_LENGTH=256
# 模型加载/推理失败时是否回退 rules（建议生产保持 true）
CHATBOT_INTENT_BERT_FALLBACK_TO_RULES=true
# 是否允许将问句判为 data_query 并走智能客服内嵌 NL2SQL（需业务库已配置）
CHATBOT_NL2SQL_ROUTE_ENABLED=true
# --- NL2SQL 查数后收紧分析（Markdown；关则成功有数据时仅出表，兼容旧行为）---
CHATBOT_NL2SQL_LLM_ANALYSIS_ENABLED=true
# 空结果时用轻量 LLM 引导改问（执行失败仍用固定友好文案，不调 LLM）
CHATBOT_NL2SQL_EMPTY_LLM_GUIDE_ENABLED=true
CHATBOT_NL2SQL_ANALYSIS_MAX_ROWS=80
# 注入收紧分析 LLM 的最大行数（默认 12；过大易触发 vLLM 上下文 400 或读超时）
CHATBOT_NL2SQL_ANALYSIS_PROMPT_MAX_ROWS=12
CHATBOT_NL2SQL_ANALYSIS_MAX_TOKENS=1024
# 分析 LLM httpx 读超时（秒）；默认 VLLMHttpClient 仅 30s，宽表明细易 ReadTimeout
CHATBOT_NL2SQL_ANALYSIS_TIMEOUT_SEC=120
CHATBOT_NL2SQL_ANALYSIS_TEMPERATURE=0.2
# finished.meta.nl2sql_analysis 旁路结构化（列/行样本），正文仍为 Markdown
CHATBOT_NL2SQL_ANALYSIS_META_ENABLED=true
# 主问答流式 LLM 的 sampling temperature（0~2，超出会被夹紧）；不设或留空则不在请求中覆盖，沿用 LLMModelConfig.temperature（指代消解、相似案例等子调用仍为代码内固定温度）
CHATBOT_MAIN_LLM_TEMPERATURE=0.45
# 未传 prompt_version 时使用的 chatbot 模板版本（configs/prompts.yaml）
CHATBOT_PROMPT_DEFAULT_VERSION=boiler_v1
# 是否在结束 meta 中生成关联推荐问句（规则+RAG片段+LLM）
CHATBOT_SUGGESTED_QUESTIONS_ENABLED=true
CHATBOT_SUGGESTED_QUESTIONS_MAX=5
# 是否启用 C-RAG（检索质量不足时重试改写） true -- RAG召回知识片段不足时，直接走澄清分支
CHATBOT_CRAG_ENABLED=false
# C-RAG 最大重试次数（含首轮后额外重试）
CHATBOT_CRAG_MAX_ATTEMPTS=2
# 检索质量阈值（0~1）；低于阈值触发重试或澄清
CHATBOT_CRAG_MIN_SCORE=0.55
# RAG 主引擎：agentic 或 hybrid
CHATBOT_RAG_ENGINE_MODE=agentic
# 主引擎失败时回退引擎
CHATBOT_RAG_ENGINE_FALLBACK=hybrid
#################################################
# 本厂/本公司/本电厂/我单位/厂里/我们这边等厂别指代 → 主 RAG 仅检索指定 namespace(限定知识检索范围)
CHATBOT_PLANT_KB_ENABLED=true
CHATBOT_PLANT_KB_NAMESPACE=Power_plant_knowledge
CHATBOT_PLANT_KB_QUERY_BOOST_NAME=华电五彩湾北一发电有限公司
# 首轮 plant 库 0 命中时是否回退全库（C-RAG 重试仍保持 plant namespace）
CHATBOT_PLANT_KB_FALLBACK_ON_EMPTY=false
# 厂别指代是否延续近几轮 user 历史；false=仅本轮含本厂/本公司等才锁 namespace（默认）；true=本轮或者最近6条user消息包含本厂/本公司都锁定namespace
CHATBOT_PLANT_KB_HISTORY_CONTINUATION=false
##################################################
# 高分 FAQ 软直通（默认开）：首条 rag_citation 的 rerank_score≥阈值且 anaphora=none 时，生成阶段不注入 history_messages(避免历史错误信息对当前推理的影响)
CHATBOT_FAQ_SOFT_DIRECT_ENABLED=false
# 闸门使用 CrossEncoder 重排分 rerank_score（非 citations.score 的 Agentic 融合分）
CHATBOT_FAQ_SOFT_DIRECT_MIN_SCORE=0.95
# 软直通时注入 LLM 的 RAG 片段条数（rag_citations 展示条数不变）
CHATBOT_FAQ_SOFT_DIRECT_SNIPPET_TOP_N=1
########################################################
# 会话历史读取条数（图中上下文窗口）
CHATBOT_HISTORY_LIMIT=20
# 结构化摘要/索引增强（旁路能力，不改变现有链路）
# 开启后：回答完成后异步提取结构化索引，热存储复用 REDIS_URL + CONV_SESSION_TTL_MINUTES + CONV_MAX_HISTORY_MESSAGES
CHATBOT_OUTLINE_ENABLED=true
# 是否异步写入结构化索引（建议开启）
CHATBOT_OUTLINE_ASYNC_ENABLED=true
# 是否在现有意图识别前叠加“上文第N点”引用解析
# 会话assistant (完整会话信息)落库后，当前会异步针对assistant 按编号行和按句切出 outline 条目 存入redis。下面开关是下轮会话时是否读取该存储的outline 条目的开关
CHATBOT_REFERENCE_RESOLVE_ENABLED=true
# 引用解析回溯最近多少轮结构化索引（支持“上面/前面/上述/第N点/继续展开”）
CHATBOT_REFERENCE_LOOKBACK_TURNS=8
# 是否将结构化索引同步写入 EasySearch 冷层（复用 CONV_ARCHIVE / RAG_ES 连接）
CHATBOT_OUTLINE_ES_ENABLED=true
CHATBOT_OUTLINE_ES_INDEX=conversation_outline_v1

# --- 智能客服指代消解（上下文 / Coref，见 docs/智能客服上下文理指代实现优化方案-20260514.md §4）---
# 指代清单 YAML（默认 configs/chatbot_anaphora.yaml；可挂载外置文件）
# CHATBOT_ANAPHORA_CONFIG_PATH=/path/to/chatbot_anaphora.yaml
# P0：检索 query 与历史融合（短指代句增强召回）
# 短指代句增强召回：通过指代消解清单chatbot_anaphora.yaml+程序规则进行短指代的命中，命中短指代后 RAG召回的query就会融合上一轮次的user和assistant进行融合检索召回（这样召回的知识给到LLM后，能够让LLM理解本轮次的短指代）
CHATBOT_ANAPHORA_RETRIEVAL_FUSION_ENABLED=true
CHATBOT_ANAPHORA_FUSION_MAX_CHARS=2800
# P1：对话锚块注入 system（默认关闭，灰度时开启）
CHATBOT_ANAPHORA_ANCHOR_BLOCK_ENABLED=false
CHATBOT_ANCHOR_BLOCK_MAX_CHARS=1200
# P2：会话槽位（Redis 优先；无 REDIS 时为进程内，不跨 worker）
CHATBOT_ANAPHORA_SLOTS_ENABLED=false
CHATBOT_ANAPHORA_SLOTS_MAX_BULLETS=8
# P3：Coref 小模型窄触发（默认关闭）
CHATBOT_ANAPHORA_LLM_GATE_ENABLED=false
CHATBOT_ANAPHORA_LLM_TIMEOUT_SEC=4
# CHATBOT_ANAPHORA_LLM_MODEL=
# SSE finished.meta 是否附带 anaphora_type 等（默认 false）
CHATBOT_ANAPHORA_EXPOSE_META=false
# 图片预处理开关：在 ChatbotService 入口前对 image_urls 执行下载+缩放+压缩+存储（minio/local）
CHATBOT_IMAGE_PREPROCESS_ENABLED=true
# 图片最长边（像素）：超过该值会等比缩放（推荐 1024~1600）
CHATBOT_IMAGE_MAX_EDGE=1280
# 原图大小超过该阈值（MB）才启用更强有损压缩
CHATBOT_IMAGE_COMPRESS_THRESHOLD_MB=2
# 有损压缩 JPEG 质量（1~95，默认 80）
CHATBOT_IMAGE_JPEG_QUALITY=80
# 图片存储后端（minio 或 local）。推荐 minio：多实例共享，且给 vLLM 提供可访问 URL。
CHATBOT_IMAGE_STORAGE_BACKEND=minio
# 本地存储目录（相对 app 目录或绝对路径）
CHATBOT_IMAGE_STORE_DIR=runtime/chatbot_images
# 静态访问前缀（由 main.py 挂载），历史会话可回显该路径图片
CHATBOT_IMAGE_PUBLIC_PATH=/chatbot/media
# MinIO（image_storage_backend=minio 时生效）
CHATBOT_IMAGE_MINIO_ENDPOINT=models-app-minio:9000
CHATBOT_IMAGE_MINIO_ACCESS_KEY=minioadmin
CHATBOT_IMAGE_MINIO_SECRET_KEY=minioadmin123
CHATBOT_IMAGE_MINIO_BUCKET=chatbot-images
CHATBOT_IMAGE_MINIO_SECURE=false
CHATBOT_IMAGE_MINIO_AUTO_CREATE_BUCKET=true
# 预签名 URL 过期秒数（vLLM 拉图使用；建议 5~30 分钟）
CHATBOT_IMAGE_MINIO_PRESIGN_TTL_SECONDS=900
# 客户端断开时是否落库 partial assistant 消息
CHATBOT_PERSIST_PARTIAL_ON_DISCONNECT=true
# 查询改写最大长度（防止 C-RAG 改写膨胀）
MAX_REWRITE_QUERY_LENGTH=256
# 图执行总时长预算（毫秒）
MAX_GRAPH_LATENCY_MS=600000
# 说明：预算从本轮请求开始计时，含 LangGraph 前序节点与主答 vLLM 流式输出；超时且已输出过正文时停止本轮流式；长回答可调大（如 120000）。
# LangGraph 图状态 checkpoint（与下方「综合分析 ANALYSIS_CHECKPOINT_*」语义一致）
# CHATBOT_CHECKPOINT_BACKEND：取值 none | memory | redis（大小写不敏感；非法值会按 none 处理）
#   - none：不持久化图状态（默认，生产无多轮续跑需求时推荐）
#   - memory：进程内 MemorySaver，重启丢失，仅开发/单机调试
#   - redis：需 langgraph.checkpoint.redis + 有效 URL；用于多 worker/断点语义（与智能客服会话 thread 策略配合时再启用）
CHATBOT_CHECKPOINT_BACKEND=none
# 仅当 CHATBOT_CHECKPOINT_BACKEND=redis 时必填；与 REDIS_URL 可同实例不同 DB（如 /1），或独立 Redis
# 示例：redis://redis:6379/1
# CHATBOT_CHECKPOINT_REDIS_URL=redis://redis:6379/1
# 逻辑命名空间（日志与运维识别用；不改变 Redis URL 本身）
CHATBOT_CHECKPOINT_NAMESPACE=chatbot_graph

# 锅炉/管材故障域 + 相似案例（限定 namespace RAG，默认关闭；见 enterprise 文档 §14）
# CHATBOT_SIMILAR_CASE_ENABLED=false
# 与知识库摄入时的 namespace 一致（可改为任意业务名）
# CHATBOT_SIMILAR_CASE_NAMESPACE=事故案例
# CHATBOT_SIMILAR_CASE_TOP_K=5
# CHATBOT_FAULT_DETECT_ENABLED=true
# 是否允许用图片参与故障判定（无图时仅文本）；请求体 enable_fault_vision 可覆盖
# CHATBOT_FAULT_VISION_ENABLED=true
# rules | llm | hybrid（关键词命中或 LLM/多模态 JSON 判定）
# CHATBOT_FAULT_DETECT_MODE=hybrid
# LLM 判定 fault_related 时的最低 confidence（0~1）
# CHATBOT_FAULT_MIN_CONFIDENCE=0.5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · NL2SQL基座（一套部署只选一个 domain）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NL2SQL配置项加载顺序：
#   1) NL2SQL_BUSINESS_DOMAIN → configs/nl2sql_business/<domain>/profile.yaml
#   2) profile.yaml → table_scope.txt / join_whitelist.txt / scope_lexicon / semantic / entity_rules
#                    以及 nl2sql.*（方言、Prompt 版本、语义开关等）与 db.*（host/port/库名/用户，不含密码）
#   3) 显式环境变量覆盖 profile（DB_* / DB_URL / NL2SQL_* / ANALYSIS_NL2SQL_*）-- 若当前.env.example中配置，会覆盖 profile.yaml中对应配置
#   即优先级：.env.example > profile.yaml
# 切换业务：只改 ① 的 domain + ② 的业务库密码；勿再写锅炉表白名单到 env。

# ① 主开关（二选一；锅炉(boiler_four_tube) / 地面沉降(subsidence)）
# NL2SQL_BUSINESS_DOMAIN=boiler_four_tube
NL2SQL_BUSINESS_DOMAIN=subsidence

# ② 业务库登录密码（必配；不进 profile.yaml）
# 含义：NL2SQL 所连「业务数据库」账号的密码，对应用户为 profile.yaml 的 db.user
#   - boiler_four_tube：TiDB/MySQL 用户 aimodel 的密码
#   - subsidence：PostgreSQL 用户 postgres 的密码
# NL2SQL_BUSINESS_DOMAIN所配置业务系统对应数据库的密码。勿把真实密码提交 git。
DB_PASSWORD=dmcj#db123.com
# 可选：整串连接覆盖 profile 拼出的 URL（密码中的 @ 须 URL 编码为 %40）
# DB_URL=mysql+aiomysql://aimodel:aimodel%402026@192.168.90.62:4000/fmfb?charset=utf8mb4
# 可选配置如下项：覆盖 profile.db.*（若配置后，会覆盖 profile.yaml中对应配置项）
# DB_HOST= / DB_PORT= / DB_USER= / DB_NAME=

# ③ NL2SQL公共配置项(与 domain 无关的运行时开关（不进 profile，两业务共用）)
# 生成期 L2/L1 缓存（进程内；详见 docs/NL2SQL缓存实现方案.md）
NL2SQL_CACHE_ENABLED=true
NL2SQL_CACHE_TTL_SECONDS=604800
NL2SQL_CACHE_MAX_ENTRIES=512
NL2SQL_L1_CACHE_ENABLED=true
# QA：校验通过的 SQL 写入 nl2sql_qa_examples；槽位命中时是否跳过 LLM 直接回放
NL2SQL_QA_FEEDBACK_ENABLED=true
NL2SQL_QA_SLOT_STRICT_REPLAY=true
# 执行/EXPLAIN 失败后是否 LLM 改 SQL、最多改几轮
NL2SQL_REFINE_ON_EXEC_ERROR=true
NL2SQL_MAX_EXEC_REFINES=1

# ④ 仅针对锅炉四管 的 TiDB 路径（地面沉降 subsidence+PostgreSQL 可忽略）
NL2SQL_TIDB_FORBIDDEN_ALIASES=load,row_number,rank,dense_rank,lead,lag,window,key,index,table,column,primary,default,desc,interval,current_date,current_time,current_timestamp

# ⑤ 未设 NL2SQL_BUSINESS_DOMAIN 时的旧版回退（已设 domain 时勿启用，表白名单走配置包 table_scope.txt）
# ANALYSIS_NL2SQL_TABLE_SCOPE_DEFAULT=
# ANALYSIS_NL2SQL_JOIN_WHITELIST=

# =============================================================================
# 应用进程 · 检修报告结构化提取 Inspection Extract（`app/core/config.py` → `InspectionExtractConfig`）
# =============================================================================
# 是否启用模块（接口层与服务层）
INSPECT_EXTRACT_ENABLED=true
# 默认严格模式：true 时若无有效记录则返回失败
INSPECT_EXTRACT_STRICT_DEFAULT=false
# 结构修复重试次数（0 表示不重试）
INSPECT_EXTRACT_MAX_REPAIR_RETRIES=1
# 默认 prompt 版本（configs/prompts.yaml 中 inspection_extract* 的 version）
INSPECT_EXTRACT_PROMPT_VERSION=v1
# 检修解析管线：v1=既有 DocumentParser 扁平 docx；v2=独立 python-docx 摄入（底纹→超标候选）+ Processing Unit 分块，与 v1 并行；默认 v1 不切生产
INSPECT_EXTRACT_PIPELINE_VERSION=v2
# V2：Processing Unit 单块最大字符 | classify 批大小（建议 20～40）
INSPECT_EXTRACT_V2_PARSE_UNIT_MAX_CHARS=3200
# V2：大表按「表头 + 数据行窗口」切分（单表超 max-chars 时；默认 true）
# INSPECT_EXTRACT_V2_TABLE_ROW_WINDOW_ENABLED=true
# V2：行窗口每块最多数据行数（表头每块复制；默认 20）
# INSPECT_EXTRACT_V2_TABLE_DATA_ROWS_PER_WINDOW=20
# V2：强信号列切（横排多 hmerge 子表；默认 false）
# INSPECT_EXTRACT_V2_TABLE_COLUMN_SPLIT_ENABLED=false
# INSPECT_EXTRACT_V2_CLASSIFY_BATCH_SIZE=40
# V2：parse 后按分块 [颜色标注] 校正检测类型（纠正同行/跨列误标；默认 true）
# INSPECT_EXTRACT_V2_COLOR_GUARD=true
# V2：并行分块解析(parse) 后按网格校正管号+壁厚绑定（程序规则校正）（默认 true）
# INSPECT_EXTRACT_V2_BIND_GUARD=true
# V2：parse 后按 chunk 列组 direction（上/下/上数/下数）校正管号正负（默认 true）
# INSPECT_EXTRACT_V2_TUBE_DIRECTION_SIGN_GUARD=true
# V2：无专用方向表头时对 fallback (0,1=上,2,3=下) 也做正负校正（默认 false）
# INSPECT_EXTRACT_V2_TUBE_DIRECTION_SIGN_ALLOW_FALLBACK_4COL=false
# V2：parse 后按 chunk 组合编号（2-1）校正行号/管号并跳过设备语义规则（默认 true）
# INSPECT_EXTRACT_V2_COMBO_GUARD=true
# Parse 送 LLM 时仅保留 [DOCX_V2_TABLE] 表格块（combo/sign/color/bind 仍用完整 chunk）
# INSPECT_EXTRACT_V2_LLM_PARSE_TABLE_ONLY=true
# LLM 表格块裁掉从右起连续全空列（如图片占位列 c4=''）并更新 cols=
# INSPECT_EXTRACT_V2_LLM_STRIP_TRAILING_EMPTY_COLS=true
# V2：单元格底纹 w:fill 命中下列十六进制（逗号分隔，无 #）时序列化为「超标候选」
# INSPECT_EXTRACT_V2_SHADING_CANDIDATE_FILLS=FF0000,C00000,F79646,E6B8B7,F2DCDB,FF6666,C0504D,943634
# 可选：指定提取模块使用的模型 ID；为空则回退 LLM_DEFAULT_MODEL
# INSPECT_EXTRACT_MODEL_NAME=default
# 单次 LLM 调用超时（秒）
# 单次 LLM 调用超时（秒）；大表+高并发排队时 vLLM 首包可能较慢，建议 300～600
INSPECT_EXTRACT_LLM_TIMEOUT_SECONDS=600
# 检修 Parse / Classify / Repair 调用 vLLM 时传入的 sampling temperature（覆盖 LLMModelConfig 同字段；未设置时代码默认 0.3）
INSPECT_EXTRACT_LLM_TEMPERATURE=0.3
# 检修 LLM 动态封顶默认使用代码内上下文长度（与大模型启动参数中 max_model_len 一致）。
# 与 vLLM --max-model-len 一致；用于按「输入 token 估算」动态压低各阶段 max_tokens，避免 400（input+max_tokens 超出上下文）
INSPECT_EXTRACT_LLM_CONTEXT_TOKENS=32768
# 估算余量：模板/特殊 token 与 tokenizer 偏差（可适当加大以更保守）
INSPECT_EXTRACT_LLM_COMPLETION_SLACK_TOKENS=768
# 各阶段期望的最大输出 token（实际上限会被上下文动态封顶；Parse 不宜过大以免大块表格时挤爆窗口）
INSPECT_EXTRACT_LLM_MAX_TOKENS_PARSE=8192
INSPECT_EXTRACT_LLM_MAX_TOKENS_CLASSIFY=1024
INSPECT_EXTRACT_LLM_MAX_TOKENS_REPAIR=768
# Parse 分块并发度（1=串行；建议从 2 开始压测，逐步调优）
INSPECT_EXTRACT_PARSE_CONCURRENCY=32
# 调试开关：是否打印 LLM 原始返回（建议仅排障时开启）
INSPECT_EXTRACT_LOG_LLM_RAW_RESPONSE=true
# 原始返回日志最大长度（字符）
INSPECT_EXTRACT_LOG_LLM_RAW_MAX_CHARS=300000
# 排障：是否打印 parse 阶段送入 LLM 的完整分块正文（便于核对表格序列化；日志量大）
# 未设置时：与 INSPECT_EXTRACT_LOG_LLM_RAW_RESPONSE 相同（只开 raw 也会打完整分块）；显式 true/false 可覆盖
INSPECT_EXTRACT_LOG_PARSE_CHUNK_FULL=true
# 完整分块日志最大字符；0=不截断（仍按 24k 左右分段多行输出）
# INSPECT_EXTRACT_LOG_PARSE_CHUNK_MAX_CHARS=0
# —— 异步检修任务（POST /inspection-extract/run/async）以下三项均有代码内默认值，不写在 .env 也生效；需要覆盖时再取消注释。
# 取消：`DELETE /inspection-extract/jobs/{job_id}`；多副本请配置 REDIS_URL（键 `inspection:extract:jobs:cancel:{job_id}`）与共享异步任务目录。
#
# 磁盘持久化根目录（与是否使用 Redis 无关）：任务元数据 job_meta.json、分块结果 chunks/*.json 等均写在此路径下；**V0 LangGraph Sqlite checkpoint**（`langgraph_checkpoint.sqlite`）亦落在各 `job_id` 子目录，须对容器进程**可写**（只读卷会导致 `unable to open database file` 后顺序回退）。多实例部署时需挂载共享盘指向同一目录。
# Docker 部署：与 compose 中 INSPECT_EXTRACT_JOBS_HOST_PATH → /workspace/data/inspection_extract_jobs 一致
INSPECT_EXTRACT_ASYNC_JOBS_DIR=/workspace/data/inspection_extract_jobs
#
# REDIS_URL 为全局变量（知识库摄入 IngestionJobQueue、检修异步队列等共用 `os.getenv("REDIS_URL")`）；若在文件前面或其它段落已配置此处不必重复。留空则检修异步队列不使用 Redis，仅在进程内起线程消费任务。
# 不设 REDIS_URL = 代码默认不走 Redis 队列；不设本节 REDIS_URL 注释也能运行。
#
# 仅在「已配置 REDIS_URL」时生效：从 Redis 队列里抢任务的 consumer 线程个数（多实例横向扩容时用），不是单次文档内 LLM 分块并发——后者请用 INSPECT_EXTRACT_PARSE_CONCURRENCY。
# 默认（代码内）：2
# INSPECT_EXTRACT_ASYNC_QUEUE_WORKERS=2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 检修报告结构化提取 V0（LangGraph + 版面 OCR 侧车；路由前缀 /inspection-extract-v0/**）
# 与现网 INSPECT_EXTRACT_* 并行。总开关见下：为 false 时业务接口返回 503（路由仍注册，便于联调）；为 true 时启动异步恢复与队列 worker。
# 异步任务与现网共用 INSPECT_EXTRACT_ASYNC_JOBS_DIR，Redis 队列为独立前缀 inspection:extract:v0:jobs。
# 企业级说明（部署顺序、侧车网络、排障）：enterprise-level_transformation_docs/企业级检修报告结构化提取V0版本实现和使用说明.md
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
INSPECT_EXTRACT_V0_ENABLED=true
# INSPECT_EXTRACT_V0_STRICT_DEFAULT=false
# INSPECT_EXTRACT_V0_PROMPT_VERSION=v2
# INSPECT_EXTRACT_V0_MODEL_NAME=
# INSPECT_EXTRACT_V0_LLM_TIMEOUT_SECONDS=300
# INSPECT_EXTRACT_V0_LLM_TEMPERATURE=0.3
# INSPECT_EXTRACT_V0_LLM_MAX_TOKENS_EXTRACT=4096
# 版面侧车（paddleocr-layout-deploy）：须与主应用同 Docker 网络（app-deploy compose 已挂 `paddle-layout-external` / `PADDLE_LAYOUT_DOCKER_NETWORK`），endpoint 写 **服务名 + 容器内 8000**（侧车 compose 服务名 `paddleocr-layout-api`）；勿写 127.0.0.1。未同网时典型报错：Name or service not known。
INSPECT_EXTRACT_V0_LAYOUT_OCR_ENDPOINT=http://paddleocr-layout-api:8000
# 仅当主应用与侧车都跑在宿主机、且侧车映射为宿主机 8010→容器 8000 时，可改为：http://127.0.0.1:8010
# INSPECT_EXTRACT_V0_LAYOUT_OCR_TIMEOUT_SECONDS=300
# INSPECT_EXTRACT_V0_LAYOUT_OCR_MAX_UPLOAD_MB=32
# INSPECT_EXTRACT_V0_MAX_PDF_PAGES=5
# doc/docx 是否走版面侧车（侧车内 LibreOffice 转 PDF 再 PaddleOCR）；false 则仅用原生 docx 解析 + 文本行 IRT。沐曦/麒麟侧车镜像若 yum 源无 LibreOffice，会出现 503 DOCX_TO_PDF_UNAVAILABLE，可临时设 false 绕过侧车 docx
# INSPECT_EXTRACT_V0_DOCX_USE_LAYOUT_OCR=true
# LangGraph 是否写 Sqlite 检查点（job 子目录 langgraph_checkpoint.sqlite）；默认 false，仅用内存 ainvoke，无 Sqlite 依赖；需人机在环/断点续跑图节点时再设 true
# INSPECT_EXTRACT_V0_LANGGRAPH_USE_SQLITE=false
# INSPECT_EXTRACT_V0_LANGGRAPH_CHECKPOINT_FILE=langgraph_checkpoint.sqlite
# IRT 中含多张表时，按表分块并行调用 LLM 的最大并发数（与现网 INSPECT_EXTRACT_PARSE_CONCURRENCY 类似）；1 表示多块顺序执行，不占并发槽
INSPECT_EXTRACT_V0_LLM_TABLE_CHUNK_CONCURRENCY=16
# 每个表块内最多带入多少条 OCR blocks（同页且与表 bbox 重叠）；过大易顶满上下文，过小可能丢表周文字
# INSPECT_EXTRACT_V0_LLM_TABLE_CHUNK_MAX_BLOCKS=120
# V0 异步队列消费线程数（REDIS_URL 启用时）；与现网检修异步 worker 分离，仅处理前缀 inspection:extract:v0:jobs
# INSPECT_EXTRACT_V0_ASYNC_QUEUE_WORKERS=2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 嵌入与重排（HF 缓存卷见 docker-compose huggingface-cache）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 【显卡设备字符串 · 按部署形态选择】
# | 形态              | compose                         | EMBEDDING_DEVICE / RAG_RERANKER_DEVICE | 可见设备变量 |
# |-------------------|---------------------------------|----------------------------------------|--------------|
# | CPU 栈            | docker-compose.yml              | cpu（或不设）                          | 无           |
# | 英伟达 GPU        | docker-nvidia/...               | cuda:0 / cuda:1                        | MODELS_APP_NVIDIA_VISIBLE_DEVICES |
# | 沐曦 GPU          | docker-mx/...                   | cuda:0 / cuda:1（Metax 兼容串）        | 特权+/dev；见 docker-mx |
# | 昇腾 Ascend       | docker-ascend/...               | npu:0 / npu:1（相对 ASCEND_RT_VISIBLE_DEVICES） | ASCEND_RT_VISIBLE_DEVICES=4,5 |
#
# 注意：容器内 npu:0 是「可见集合内的相对编号」。昇腾若 ASCEND_RT_VISIBLE_DEVICES=4,5，
# 则容器内第一张仍是 npu:0（对应宿主机 4）。
#
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
# 优先使用本地模型目录（离线部署推荐）；设置后优先于 EMBEDDING_MODEL_NAME
# EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
# EMBEDDING_MODEL_PATH=/workspace/models/embeddings/bge-small-zh-v1.5
# EMBEDDING_MODEL_PATH=/workspace/models/embeddings/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_PATH=/workspace/models/embeddings/bge-large-zh-v1.5
# Qwen3-Embedding：检索 query 使用模型内置 "query" prompt；知识摄入 chunk 不带 prompt（见 app/rag/embedding_service.py），关闭 Qwen 专用项，使用bge时（空或删除）
# EMBEDDING_QUERY_PROMPT_NAME=query
EMBEDDING_QUERY_PROMPT_NAME=
# EMBEDDING_TRUST_REMOTE_CODE=true
EMBEDDING_TRUST_REMOTE_CODE=false
RAG_RERANKER_MODEL_NAME=BAAI/bge-reranker-large
# RAG_RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
# 本地重排模型路径（离线部署推荐）；设置后优先于 RAG_RERANKER_MODEL_NAME
# 必须为已存在的目录（内含 CrossEncoder 所需文件）；若路径无效则自动回退到 RAG_RERANKER_MODEL_NAME，避免把绝对路径误当 HF repo id
RAG_RERANKER_MODEL_PATH=/workspace/models/rerank/bge-reranker-large
# RAG_RERANKER_MODEL_PATH=/workspace/models/rerank/Qwen3-Reranker-0.6B
RAG_RERANKER_TRUST_REMOTE_CODE=false
# 使用Qwen3-Reranker时配置为true
# RAG_RERANKER_TRUST_REMOTE_CODE=true

# ---------- 嵌入/重排调用后端（默认 MIS-TEI 独立服务；local=进程内 ST/CrossEncoder）----------
# EMBEDDING_BACKEND / RAG_RERANKER_BACKEND 配置说明
# mis_tei：HTTP → mis-tei-deploy（推荐昇腾 310P，规避进程内 SDPA）  -- 针对310P环境运行嵌入和重排模型
# local：进程内加载 EMBEDDING_MODEL_PATH / RAG_RERANKER_MODEL_PATH（需配合 DEVICE）   -- 针对nvidia或cpu环境运行嵌入和重排模型
EMBEDDING_BACKEND=mis_tei
RAG_RERANKER_BACKEND=mis_tei
MIS_TEI_EMBED_BASE_URL=http://mis-tei-embed:8080
MIS_TEI_RERANK_BASE_URL=http://mis-tei-rerank:8080
MIS_TEI_TIMEOUT_S=120
MIS_TEI_EMBED_BATCH_SIZE=32
MIS_TEI_RERANK_BATCH_SIZE=16
MIS_TEI_EMBEDDING_DIM=1024
MIS_TEI_NORMALIZE_EMBEDDINGS=true
# Docker 网络名须与 mis-tei-deploy/.env 中 MIS_TEI_NETWORK_NAME 一致；ascend compose 以 external 接入
MIS_TEI_NETWORK_NAME=mis-tei-stack
# 回退进程内示例：
# EMBEDDING_BACKEND=local
# RAG_RERANKER_BACKEND=local
# EMBEDDING_DEVICE=cpu
# RAG_RERANKER_DEVICE=cpu

# ---------- 设备与可见卡（与上方 EMBEDDING_DEVICE / RAG_RERANKER_DEVICE 成对配置）----------
# 说明：仅当 EMBEDDING_BACKEND=local / RAG_RERANKER_BACKEND=local 时生效。
# mis_tei 模式下嵌入/重排由独立容器占 NPU 4/5，models-app 可不跑 ST。
# --- 英伟达（docker-nvidia/）---
# EMBEDDING_DEVICE=cuda:0
# RAG_RERANKER_DEVICE=cuda:1
# MODELS_APP_NVIDIA_VISIBLE_DEVICES=all
# MODELS_APP_GPU_DEVICE_COUNT=all
#
# --- 沐曦（docker-mx/）---
# 设备串常用 cuda:0 / cuda:1（Metax 兼容）；一般不设 NVIDIA_*；特权模式 + /dev 由 compose 处理
# EMBEDDING_DEVICE=cuda:0
# RAG_RERANKER_DEVICE=cuda:1
#
# --- 昇腾 Ascend（docker-ascend/ · 地面沉降 / Atlas 300I Duo · §5）---
# 与 vLLM / MinerU 同底座（CANN 9.1.0 / Python 3.12）；须与宿主机 HDK 26.1.1 配套
BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0-310p
# 默认推荐 EMBEDDING_BACKEND=mis_tei：NPU 4/5 给 mis-tei-embed/rerank（见 mis-tei-deploy）
# 以下 DEVICE 仅 local 后端使用；mis_tei 时可忽略或保留作回退
# EMBEDDING_DEVICE=npu:0
EMBEDDING_DEVICE=cpu
# RAG_RERANKER_DEVICE=npu:1
RAG_RERANKER_DEVICE=cpu
# models-app 仍挂 4,5 时仅在 local+npu 路径使用；mis_tei 时勿与 mis-tei 争用 4/5
# ASCEND_RT_VISIBLE_DEVICES=4,5
ASCEND_RT_VISIBLE_DEVICES=
# ASCEND_DOCKER_RUNTIME=ascend
# MODELS_APP_IMAGE=models-app:ascend

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · RAG 行为（更多键见 app/core/config.py）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RAG_ENABLE_BY_DEFAULT=true
# 上下文开关默认值（接口请求未显式传参时生效）
RAG_ENABLE_CONTEXT_BY_DEFAULT=true
# 传统检索 TopK（各场景还可被 scene 配置覆盖）
RAG_TOP_K=5

# 摄入 content 为 http(s) 文件 URL 时拉取（默认关闭；生产务必配白名单）
# RAG_CONTENT_FETCH_ENABLED=false
RAG_CONTENT_FETCH_ENABLED=true
RAG_CONTENT_FETCH_MAX_BYTES=314572800
RAG_CONTENT_FETCH_TIMEOUT_S=600
# 非空时仅允许列表内主机（逗号分隔）；支持 *.suffix.com 匹配子域
# RAG_CONTENT_FETCH_ALLOW_HOSTS=files.example.com,cdn.example.com
# 防止 SSRF配置(如果解析结果是私网/本地网段,就拒绝拉取)
RAG_CONTENT_FETCH_BLOCK_PRIVATE=false
# RAG_CONTENT_FETCH_BEARER_TOKEN=
# RAG_CONTENT_FETCH_HEADER_NAME=
# RAG_CONTENT_FETCH_HEADER_VALUE=
# 启动后自动回收并重排队重启前遗留的 RUNNING 摄入任务（强制启用，无开关）
# RUNNING 超过该秒数未更新则判定卡死并转 FAILED（默认 30 分钟）
RAG_RUNNING_STUCK_TIMEOUT_SECONDS=1800
# 是否启用混合检索（语义 + 关键词 + RRF + 重排）
RAG_HYBRID_ENABLED=true
# 全库检索（namespace 未指定）时 namespace 优先级加权系数 β；adjusted_score = score - β*(priority-1)  ；priority为namespace的优先级，priority=1时，不加权
# RAG_NAMESPACE_PRIORITY_BOOST=0.05
# 是否按 priority 分层召回（默认 false。）
# false -- 使用加权融合，语义相关性仍占主导，优先级 只是微调排序
# true -- 使用分层召回，强约束「priority=1 先占满 top_k」，即使 priority=5 的 chunk 语义分更高也可能进不了结果，适合业务上严格的 namespace 优先级分层
RAG_NAMESPACE_PRIORITY_TIERED=true
# 是否启用 Agentic 检索策略（多步规划检索）
RAG_AGENTIC_ENABLED=true
# 场景化 TopK / 混合检索子参数（可选；未设置则用代码默认值）。
# 综合分析「结论前」业务 RAG 使用 scene=analysis（`AnalysisGraphRunner._retrieve_business_rag`）：
# RAG_SCENE_ANALYSIS_TOP_K=8
# RAG_SCENE_ANALYSIS_SEMANTIC_TOP_K=32
# RAG_SCENE_ANALYSIS_KEYWORD_TOP_K=32
# RAG_SCENE_ANALYSIS_RERANK_TOP_N=16
# 综合分析「规划前」schema/口径类检索使用 scene=nl2sql（`AnalysisGraphRunner._retrieve_plan_rag` → plan_context_rag）：
# RAG_SCENE_NL2SQL_TOP_K=5
# RAG_SCENE_NL2SQL_SEMANTIC_TOP_K=20
# RAG_SCENE_NL2SQL_KEYWORD_TOP_K=20
# RAG_SCENE_NL2SQL_RERANK_TOP_N=12
# 其它 scene：chatbot / llm_inference 及默认值见 `app/core/config.py` → `RAGSceneProfilesConfig`

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · MinerU（mineru-deploy 独立栈；须与 docker-compose 中 mineru-external 同时使用）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 是否启用 MinerU 解析（接入代码落地后生效；未实现前保持 false）
MINERU_ENABLED=true
# 容器内访问 mineru-api：端口必须是 MinerU 容器内监听端口（本栈为 8000），与 vLLM 容器内 8000 不冲突
# 勿使用宿主机映射端口 MINERU_PORT（如 8009）；详见 mineru-deploy/README.md §7
MINERU_BASE_URL=http://mineru-api:8000
# 单次解析 HTTP 超时（秒）；大扫描 PDF 建议 600～3600，按 SLA 调整
MINERU_TIMEOUT_S=43200
# 等待 MinerU 并发槽位（Redis sem_pool）的最长时间（秒）；与 MINERU_TIMEOUT_S 独立，避免槽位耗尽时 job 静默挂数小时(当前配置48小时)
MINERU_GATE_WAIT_TIMEOUT_S=172800
# 应用侧并发调用上限（保护同机资源；与 mineru-deploy 内并发策略对齐）
MINERU_MAX_CONCURRENT=2
# 应用容器内与 mineru-deploy 共享 IO 的挂载点（与 docker-compose 中卷目标路径一致）
MINERU_IO_CONTAINER_PATH=/workspace/mineru-io
# mineru-api /file_parse 表单：backend、parse_method（扫描件建议 ocr）、语言
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=ocr
MINERU_LANGUAGE=ch
# CPU 压力控制：可关闭高开销模块（复杂公式/表格）
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
# 大 PDF 分段解析：0=不分段；建议先从 50~100 页/批试起
MINERU_PAGE_BATCH_SIZE=20
# 抽样页平均可提取字符低于该阈值则视为扫描 PDF，走 MinerU（文字 PDF 仍走 pypdf）
MINERU_PDF_SCANNED_MAX_AVG_CHARS=40
# 多 worker 时与 REDIS_URL 配合的全局并发池键前缀；池空且 holders=0 时应用会自动补种（防 worker 崩溃泄漏）
MINERU_REDIS_SEM_KEY_PREFIX=mineru:ingest
# 一般无需修改
# MINERU_FILE_PARSE_PATH=/file_parse
# 与 mineru-deploy 中 MINERU_API_OUTPUT_ROOT 最后一级目录一致（共享 IO 卷上的子目录名）
# MINERU_DISK_FALLBACK_SUBDIR=mineru-output

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 知识图谱 / GraphRAG（默认全部关闭；需独立 Neo4j 时再按需开启）
# 推荐启用顺序：1) 部署 graphrag_db-deploy  2) GRAPH_RAG_ENABLED=true
#   3) 按需 GRAPH_RAG_INGEST_ON_RAG / GRAPH_RAG_MODE=hybrid
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
GRAPH_RAG_ENABLED=false
GRAPH_RAG_INGEST_ON_RAG=false
GRAPH_RAG_DELETE_ON_RAG=false
GRAPH_RAG_MODE=vector
# GRAPH_RAG_DELETE_ON_RAG=true 时，RAG 删文档会同步清理 Neo4j 图侧数据（无需开启 INGEST_ON_RAG）
# Neo4j Bolt 地址（容器间建议使用服务名）
# NEO4J_URI=bolt://graph-neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
GRAPH_SCHEMA_CONFIG_PATH=configs/graph_schema.yaml
GRAPH_SCHEMA_HOT_RELOAD=false
GRAPH_EXTRACTION_MODE=llm
GRAPH_EXTRACTION_FALLBACK_RULE=false
# GRAPH_LLM_ENDPOINT=          # 空则复用 LLM 默认 endpoint
# GRAPH_LLM_MODEL=             # 空则复用 LLM 默认 chat 模型
GRAPH_LLM_TIMEOUT_S=120
GRAPH_LLM_MAX_TOKENS=2048
GRAPH_LLM_BATCH_SIZE=4
GRAPH_LLM_MAX_RETRIES=2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · 可观测性（可选）
# 当前应用观测采用 Redis + Tempo（专网可观测）模式，即通过Trace埋点的指标数据，实现指标数据API查询和Grafana查看执行链路
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
# 是否把运行轨迹同步到 LangSmith（云端/自建 LangSmith），配置为true时，需要同时配置LANGSMITH_API_KEY和LANGSMITH_PROJECT（当前项目基本都是内网环境部署，不具备云端LangSmith访问条件，所以默认关闭）
# LANGSMITH_ENABLED=false
# LANGSMITH_ASYNC=true
# LANGSMITH_SAMPLE_RATE=1.0
# LANGSMITH_MIRROR_MODULES=analysis,analysis_agent,chatbot,nl2sql,llm_infer
# LANGSMITH_ENDPOINT=

# ---- 统一执行轨迹 Execution Trace（旁路观测；默认不影响业务逻辑）----
# 方案：docs/系统执行轨迹与LangSmith观测改造方案.md
# 推荐生产路径：Redis（结构化 API GET /ops/traces*）+ Tempo（Grafana 瀑布图）
# 二者并行：Redis 供运维 JSON 查询；Tempo 供链路可视化。不要用业务 ES 做 Trace 热库。
# EXECUTION_TRACE_ENABLED=true
# 未设置 BACKEND 时：有 REDIS_URL → redis，否则 memory。显式推荐：
EXECUTION_TRACE_BACKEND=redis
# redis TTL（分钟；应用重启后轨迹仍在，直至过期）
EXECUTION_TRACE_TTL_MINUTES=2880
# EXECUTION_TRACE_MAX_ITEMS=10000
# EXECUTION_TRACE_MODULES=analysis,analysis_agent,chatbot,nl2sql,llm_infer,rag_ingest,inspection_extract,graph_rebuild
# EXECUTION_TRACE_QUERY_MAX_CHARS=2048
# ANALYSIS_TRACE_DUAL_WRITE=true
#
# ---- OTLP → Tempo（monitoring-deploy：COMPOSE_PROFILES=tracing）----
# 1) monitoring-deploy: bash scripts/prepare-data-dirs.sh && COMPOSE_PROFILES=tracing docker compose up -d tempo
# 2) models-app 与 monitoring-tempo 同在 docker_vllm-network 时用容器名（推荐）：
# 开关：要不要把执行轨迹再抄一份发给 Tempo（给 Grafana 画瀑布图用）
# false / 不配：只写 Redis，你能用 /ops/traces、/rag/traces 查 JSON，Grafana 里看不到链路图
# true：业务跑完后，额外异步推一份到 Tempo；失败也不影响业务
EXECUTION_TRACE_OTLP_ENABLED=true
# 上述数据推送地址，即monitoring-tempo应用
OTEL_EXPORTER_OTLP_ENDPOINT=http://monitoring-tempo:4318
# 备选（跨网不通时走宿主机端口映射）：
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# 本实现发送 OTLP/HTTP JSON；落 Redis 前可预写 meta.tempo_trace_id（默认开）
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_SERVICE_NAME=models-app
# OTEL_TRACE_SAMPLE_RATE=1.0
# OTEL_JOB_LIVE_EXPORT=false
# OTEL_PREASSIGN_TRACE_ID=true
# 探活：GET /ops/traces-status（Bearer SERVICE_API_KEY）

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 应用进程 · FAISS 向量库（与 ES 二选一；开发单机可用）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RAG_VECTOR_STORE_TYPE=faiss
# 须与 docker-compose 中 RAG_FAISS_DATA_HOST_PATH → /workspace/data/faiss 一致
RAG_FAISS_INDEX_DIR=/workspace/data/faiss

## =============================================================================
## ━━ Compose 专用（宿主机解析；勿与「仅应用读取」混淆）━━━━━━━━━━━━━━━━━━━━
## =============================================================================
## 下列变量在 docker-compose.yml 中通过 ${VAR:-默认值} 使用；不会自动被 app/core/config.py 使用，
## 除非同时作为普通环境变量注入容器（Compose env_file 会整份注入，应用若「恰巧」同名才会读到——
## 下列键名仅为避免冲突，与业务无关，应用代码可忽略）。
##
## APP_PORT                models-app 映射到宿主机的端口
## APP_PORT_GPU            models-app-gpu 映射到宿主机的端口（profile small-model-gpu）
## VLLM_DOCKER_NETWORK     已存在的 Docker 网络名，用于连接 vLLM
## RAG_DOCKER_NETWORK      已存在的 Docker 网络名，用于连接 EasySearch
## MINERU_DOCKER_NETWORK   已存在的 Docker 网络名，用于连接 mineru-api（mineru-deploy）
## PADDLE_LAYOUT_DOCKER_NETWORK 已存在的 Docker 网络名，用于连接 paddleocr-layout-api（paddleocr-layout-deploy）；
##                         须与侧车 compose 中 PADDLE_LAYOUT_NETWORK_NAME 一致（默认 paddle-layout-stack）。
##                         未部署侧车时可用占位：docker network create paddle-layout-stack
## MINERU_IO_HOST_PATH     宿主机目录，与 mineru-deploy 的 MINERU_IO_HOST_PATH 必须相同；
##                         bind 到应用容器 MINERU_IO_CONTAINER_PATH（默认 /workspace/mineru-io）
## GRAPH_DOCKER_NETWORK    已存在的 Docker 网络名，用于连接 Neo4j（GraphRAG）
## EMBEDDING_MODELS_HOST_PATH
##                         宿主机绝对路径（根目录）→ 组合挂载 ${EMBEDDING_MODELS_HOST_PATH}/Qwen3-Embedding-0.6B
## RERANKER_MODELS_HOST_PATH
##                         宿主机绝对路径（根目录）→ 组合挂载 ${RERANKER_MODELS_HOST_PATH}/Qwen3-Reranker-0.6B
## INTENT_MODELS_HOST_PATH
##                         宿主机绝对路径（根目录）→ 组合挂载 ${INTENT_MODELS_HOST_PATH}/chatbot-intent-bert
##                         配合 CHATBOT_INTENT_BERT_MODEL_PATH=/workspace/models/intent/chatbot-intent-bert
##                         目录内须为已微调三分类模型，非魔塔通用预训练 BERT
## INTENT_LLM_MODELS_HOST_PATH
##                         宿主机意图轻量 LLM 根目录（默认 /aidata/models/llm）→ 组合挂载 qwen2.5-0.5b-instruct 子目录
##                         配合 CHATBOT_INTENT_LLM_MODEL_PATH=/workspace/models/llm/qwen2.5-0.5b-instruct
## SMALL_MODEL_WEIGHTS_HOST_PATH
##                         宿主机绝对路径 → 只读挂载到 GPU 容器 /workspace/models/small
## SMALL_MODEL_NVIDIA_VISIBLE_DEVICES
##                         传入 models-app-gpu 容器的 NVIDIA_VISIBLE_DEVICES（默认 all）
## MODELS_APP_NVIDIA_VISIBLE_DEVICES
##                         docker-nvidia 栈 models-app 可见 GPU（默认 all）；配合 EMBEDDING_DEVICE / RAG_RERANKER_DEVICE 分卡
## MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
##                         MinIO 管理员账号（用于创建 bucket/控制台登录）
## MINIO_PORT / MINIO_CONSOLE_PORT
##                         MinIO API/Console 映射到宿主机端口
## REDIS_DATA_HOST_PATH    宿主机目录 → bind 到 Redis 容器 /data（持久化 AOF/RDB；部署前须存在且权限可写）
## MINIO_DATA_HOST_PATH    宿主机目录 → bind 到 MinIO 容器 /data（对象数据；部署前须存在且权限可写）
## SESSION_STORAGE_HOST_PATH  宿主机目录 → bind 到 models-app 内 /workspace/data/conversation_archive（与 CONV_ARCHIVE_OBJECT_LOCAL_DIR 一致）
## INSPECT_EXTRACT_JOBS_HOST_PATH  宿主机目录 → bind 到 /workspace/data/inspection_extract_jobs（与 INSPECT_EXTRACT_ASYNC_JOBS_DIR 一致）
## RAG_FAISS_DATA_HOST_PATH  宿主机目录 → bind 到 /workspace/data/faiss（与 RAG_FAISS_INDEX_DIR 一致；仅 RAG_VECTOR_STORE_TYPE=faiss 时使用）
## APP_SOURCE_HOST_PATH      宿主机 app 源码 → /workspace/app（默认 /opt/deploy/models_app_framework/app）
## CONFIGS_HOST_PATH         宿主机 configs → /workspace/configs（默认 /opt/deploy/models_app_framework/configs）
## =============================================================================

APP_PORT=8083

# 须在「已存在」的外部网络；与 vllm-deploy、rag_db-deploy 实际名称一致（docker network ls）
VLLM_DOCKER_NETWORK=docker_vllm-network
RAG_DOCKER_NETWORK=ai-stack
# MinerU 外部网络名，须与 mineru-deploy/.env 中 MINERU_NETWORK_NAME 一致（docker network ls 可见）。
# 若尚未部署 mineru-deploy，可先占位：docker network create mineru-stack
MINERU_DOCKER_NETWORK=mineru-stack
# 与 paddleocr-layout-deploy 中 PADDLE_LAYOUT_NETWORK_NAME 一致；检修 V0 版面侧车与 models-app 须同网，否则 INSPECT_EXTRACT_V0_LAYOUT_OCR_ENDPOINT 无法解析主机名。
PADDLE_LAYOUT_DOCKER_NETWORK=paddle-layout-stack
# 与 mineru-deploy/.env 中 MINERU_IO_HOST_PATH 保持一致（Linux 示例）；未配置时使用 compose 占位卷 mineru-io-dummy
# MINERU_IO_HOST_PATH=/aidata/mineru/io
# GraphRAG / Neo4j 外部网络名，需与 graphrag_db-deploy/.env 中 NEO4J_NETWORK 一致
GRAPH_DOCKER_NETWORK=graph-stack
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- 业务源码 bind mount（离线服务器：sync 后 restart，无需 rebuild 镜像）----------
# 默认项目根：/opt/deploy/models_app_framework（与 compose 中 mount 一致）
DEPLOY_ROOT=/opt/deploy/models_app_framework
APP_SOURCE_HOST_PATH=/opt/deploy/models_app_framework/app
CONFIGS_HOST_PATH=/opt/deploy/models_app_framework/configs
# InsightFace 权重目录（在 app mount 之下；也可单独指向其它宿主机路径）
INSIGHTFACE_MODELS_HOST_PATH=/opt/deploy/models_app_framework/app/small_models/pretrained/insightface

# ---------- 数据目录 bind mount（仅 docker-compose 解析；与上方应用内路径成对使用）----------
# Linux 示例：部署前在宿主机创建目录并保证 Docker 可访问（常见 chown 给容器内 UID 或放宽权限）
REDIS_DATA_HOST_PATH=/aidata/data/redis_data
MINIO_DATA_HOST_PATH=/aidata/data/minio_data
SESSION_STORAGE_HOST_PATH=/aidata/data/session_storage
INSPECT_EXTRACT_JOBS_HOST_PATH=/aidata/data/inspect_extract_jobs
RAG_FAISS_DATA_HOST_PATH=/aidata/data/faiss_data

# RAG 离线模型宿主机路径（推荐统一路径约定）
EMBEDDING_MODELS_HOST_PATH=/aidata/models/embeddings
RERANKER_MODELS_HOST_PATH=/aidata/models/reranker
# BERT 意图模型宿主机根目录（仅 CHATBOT_INTENT_BACKEND=bert 时需要挂载）
INTENT_MODELS_HOST_PATH=/aidata/models/intent
# 意图轻量 LLM 宿主机根目录(目前智能客服的意图识别使用)（仅 CHATBOT_INTENT_BACKEND=llm 时需要挂载；与嵌入模型相同 HF 直挂）
INTENT_LLM_MODELS_HOST_PATH=/aidata/models/llm

# 显卡可见性 / EMBEDDING_DEVICE / RAG_RERANKER_DEVICE / ASCEND_RT_VISIBLE_DEVICES
# 见上文「应用进程 · 嵌入与重排」中的「设备与可见卡」小节（勿在此重复配置）。

# ---------- profile: small-model-gpu（docker compose --profile small-model-gpu）----------
# GPU 版 API 对外端口（避免与 APP_PORT 冲突）；主要适用于英伟达 small-model profile
APP_PORT_GPU=8081
# 仅起 GPU 实例且占 8080：先 stop models-app，再设 APP_PORT_GPU=8080
SMALL_MODEL_NVIDIA_VISIBLE_DEVICES=all
# 示例 Linux：SMALL_MODEL_WEIGHTS_HOST_PATH=/opt/small-model-weights
# 示例 Windows：SMALL_MODEL_WEIGHTS_HOST_PATH=F:/weights/small
# 不设置或整行不写：compose 使用占位卷 small-model-weights-dummy（无真实权重，仅便于调试 compose）
# InsightFace 模型宿主机目录（buffalo_l 等 ONNX）；挂载到容器 app/small_models/pretrained/insightface
# 示例：INSIGHTFACE_MODELS_HOST_PATH=/aidata/models/insightface
# 不设置时使用占位卷 insightface-models-dummy（首次 API 调用时在卷内自动下载）
# INSIGHTFACE_MODELS_HOST_PATH=/aidata/models/insightface

# ---------- 人脸向量库 Milvus（FACE_VECTOR_BACKEND=milvus；见 face_db-deploy/）----------
# 默认 local：JSON + 进程内 numpy/faiss，零外部依赖
# FACE_VECTOR_BACKEND=local
# FACE_VECTOR_BACKEND=milvus
# MILVUS_URI=http://milvus-standalone:19530
# MILVUS_FACE_COLLECTION=face_embeddings
# FACE_EMBEDDING_DIM=512
# MILVUS_FACE_METRIC=COSINE
# 与 face_db-deploy 中 FACE_MILVUS_NETWORK 一致；models-app 须加入该 external 网络
# FACE_MILVUS_NETWORK=face-milvus-stack



# =============================================================================
# 应用进程 · 综合分析 Analysis（`app/core/config.py` → `AnalysisConfig`）
# =============================================================================
# 【概念区分】
#   - Trace 归档（ANALYSIS_TRACE_*）：HTTP 管理端列表/详情/统计用的「分析结果 JSON」持久化，实现见
#     `app/services/analysis_trace_store.py` → `create_analysis_trace_store`。
#   - LangGraph checkpoint（ANALYSIS_CHECKPOINT_*）：单次请求内图节点状态的「可选」持久化，与 Trace 无关；
#     编译逻辑见 `AnalysisGraphRunner._build_analysis_checkpointer`（与智能客服 `CHATBOT_CHECKPOINT_*` 语义类似）。
#   - 提示词：默认文件 `configs/prompts.yaml`，由 `PromptTemplateRegistry` 加载；业务扩展主要改 YAML 而非 env
#     （本节末尾「RAG 场景参数」与 chatbot 区 `CHATBOT_PROMPT_DEFAULT_VERSION` 等除外）。
#
# 【数值钳制】未设置的环境变量走代码默认值；读取后常见下限：`get_app_config().analysis` 构造处对整数/浮点有
#   max/min 限制（与下表「范围」一致），避免误配导致异常。
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# A. 接口层默认（请求体 `options` 未填时由 `AnalysisService._apply_defaults_*` 补齐）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# | 变量 | 作用 | 取值范围 / 说明 |
# |------|------|----------------|
# | ANALYSIS_DEFAULT_REPORT_TEMPLATE | 报告模板标识默认 | 字符串，默认 standard；与 `_build_structured_report` 分支相关 |
# | ANALYSIS_DEFAULT_CHART_MODE | 图表输出策略默认 | `auto` \| `minimal` \| `off`；非法值回落为 config 默认 `auto` |
# | ANALYSIS_DEFAULT_REPORT_STYLE | 报告风格默认 | 字符串，如 standard |
# | ANALYSIS_DEFAULT_MAX_NL2SQL_CALLS | 单次 nl2sql 分析最多子查询条数 | 整数 ≥1，代码 `max(1, env)`，与 `plan_tasks` 截断一致 |
# | ANALYSIS_DEFAULT_MAX_ROWS_PER_QUERY | 每条 NL2SQL 返回行上限 | 整数 ≥50，代码 `max(50, env)` |
# | ANALYSIS_DEFAULT_MAX_SUGGESTIONS | 建议列表条数上限 | 1～20，代码 `max(1, min(20, env))` |
# | ANALYSIS_SYNTHESIS_TIMEOUT_SECONDS | synthesis 阶段 LLM 超时（秒） | ≥5，默认 90 |
# | ANALYSIS_SYNTHESIS_GATHERED_JSON_MAX_CHARS | synthesis user 中 gathered_data JSON 最大字符 | 整数 ≥1000，默认 16000 |
# | ANALYSIS_SYNTHESIS_MAX_TOKENS | synthesis LLM 输出 max_tokens | 整数 ≥256，默认 8192 |
# | ANALYSIS_STRICT_BY_DEFAULT | 是否默认开启严格质量门 | `true`\|`false`；true 时 payload/nl2sql 不达标可失败，见 `_evaluate_*_quality` |
# ANALYSIS_DEFAULT_REPORT_TEMPLATE=standard
# ANALYSIS_DEFAULT_CHART_MODE=auto
# ANALYSIS_DEFAULT_REPORT_STYLE=standard
# ANALYSIS_DEFAULT_MAX_NL2SQL_CALLS=8   # 超温 v2：q1～q7（20260602 四段式）
# ANALYSIS_DEFAULT_MAX_ROWS_PER_QUERY=2000
# ANALYSIS_DEFAULT_MAX_SUGGESTIONS=8
# synthesis（总结生成）阶段超时（秒）：仅作用于 analysis_graph_runner._generate_summary / _stream_summary_text
# ANALYSIS_SYNTHESIS_TIMEOUT_SECONDS=90
# synthesis user 消息中 gathered_data（json.dumps 整包）最大字符数，默认 16000（acquire_data中NL2SQL查询到的数据 传入最终报告分析 提示词中的最大token数）
ANALYSIS_SYNTHESIS_GATHERED_JSON_MAX_CHARS=16000
# synthesis 输出 max_tokens，默认 8192（六章+附录多表时 3072 易中途截断；max-model-len=40960 时仍可加大）
ANALYSIS_SYNTHESIS_MAX_TOKENS=8192

# ---------- 报告最终分析生成(synthesis)策略分支配置(v1 LLM一次生成/v2 多槽位并行）（默认 v1 保持现网）见 docs/综合分析优化版本实现方案(v2版本).md [开始]----------
# | ANALYSIS_SYNTHESIS_STRATEGY | 全局默认 v1\|v2 | 默认 v1 |
# | ANALYSIS_SYNTHESIS_STRATEGY_OVERHEAT_GUIDANCE | 超温专项覆盖 | 如 v2 |
# | ANALYSIS_PLAN_TEMPLATE_VERSION | 全局：NL2SQL 数据计划模板 version | 专项未配时生效；均未配且 effective v2 则默认 v2 |
# | ANALYSIS_PLAN_TEMPLATE_VERSION_<专项> | 按 analysis_type 覆盖 plan 版本 | 如 _OVERHEAT_GUIDANCE=v2 |
# | ANALYSIS_SYNTHESIS_TEMPLATE_VERSION | 全局：synthesis 整篇 system 模板 version | 同上 |
# | ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_<专项> | 按专项覆盖 synthesis 模板 version | v1 路径也可强制选版 |
# | ANALYSIS_SYNTHESIS_V2_MAX_PARALLEL_LLM | v2 叙述槽 LLM 并行上限 | 默认 3 |
# | ANALYSIS_SYNTHESIS_V2_SEGMENT_MAX_TOKENS | v2 单槽 max_tokens | 默认 4096 |
# | ANALYSIS_SYNTHESIS_V2_TABLE_MAX_ROWS | 程序表最大行数 | 默认 80 |
# | ANALYSIS_SYNTHESIS_V2_ENABLE_STRUCTURED_SSE | 流式是否推送 table/chart 事件 | 默认 true |
# | ANALYSIS_SYNTHESIS_V2_STREAM_LIVE_FIRST | 首槽 LLM 抢先流式（乱序，仅调试） | 默认 false；生产请保持 false |
# | ANALYSIS_SYNTHESIS_V2_STREAM_CHUNK_CHARS | 确定性槽 Markdown 分块字数 | 默认 16 |
# | ANALYSIS_SYNTHESIS_V2_STREAM_CHUNK_DELAY_MS | 每块 summary_delta 间隔（毫秒，打字节奏） | 默认 18；设 0 关闭 |
# 全局 synthesis 策略（所有 analysis_type 的默认值，未单配置下面各专项synthesis策略时 兜底策略）
#   v1：现网行为，单次 LLM 生成整篇报告（system+user，见 _generate_summary / _stream_summary_text）
#   v2：多槽位编排（程序表/图 + 多段叙述 LLM，按章节顺序流式输出）；若该类型无槽位注册表则自动回退 v1
ANALYSIS_SYNTHESIS_STRATEGY=v1

# 按专项 analysis_type 覆盖上述全局策略（仅接受 v1 或 v2；留空/注释则沿用 ANALYSIS_SYNTHESIS_STRATEGY）
# 对应 API/模型中的 analysis_type 字段；img_diag 看图诊断在代码中固定走 v1，不受此处影响
ANALYSIS_SYNTHESIS_STRATEGY_OVERHEAT_GUIDANCE=v2          # 超温分析；P0 已注册 v2 槽位（九章节）
# ANALYSIS_SYNTHESIS_STRATEGY_MAINTENANCE_STRATEGY=v2         # 检修策略（槽位未注册前设 v2 会回退 v1）
# ANALYSIS_SYNTHESIS_STRATEGY_FOUR_TUBE_HEALTH_INTERPRETATION=v2  # 四管健康报告智能解读（槽位未注册前设 v2 会回退 v1）
# ANALYSIS_SYNTHESIS_STRATEGY_LEAKAGE_BURST_ANALYSIS=v2       # 泄爆分析（槽位未注册前设 v2 会回退 v1）
# ANALYSIS_SYNTHESIS_STRATEGY_CUSTOM=v2                       # 自定义分析类型

# NL2SQL 数据计划模板版本（prompts.yaml → analysis_plan_<analysis_type> 的 version）
#   解析顺序：专项 ANALYSIS_PLAN_TEMPLATE_VERSION_<专项> > 全局 ANALYSIS_PLAN_TEMPLATE_VERSION >
#   均未配置且该类型 effective synthesis=v2 时默认 v2；effective v1 且均未配置则为 null（user_id hash 选版）
ANALYSIS_PLAN_TEMPLATE_VERSION=v2
ANALYSIS_PLAN_TEMPLATE_VERSION_OVERHEAT_GUIDANCE=v2
ANALYSIS_PLAN_TEMPLATE_VERSION_MAINTENANCE_STRATEGY=v1
ANALYSIS_PLAN_TEMPLATE_VERSION_FOUR_TUBE_HEALTH_INTERPRETATION=v1
ANALYSIS_PLAN_TEMPLATE_VERSION_LEAKAGE_BURST_ANALYSIS=v1
ANALYSIS_PLAN_TEMPLATE_VERSION_CUSTOM=v1

# synthesis 整篇 system 模板版本（prompts.yaml → analysis_synthesis_<type>；v2 多槽主用 narrative 子场景）
#   解析顺序同 plan：专项 > 全局 >（仅 effective v2 时）默认 v2
ANALYSIS_SYNTHESIS_TEMPLATE_VERSION=v2
ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_OVERHEAT_GUIDANCE=v2
ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_MAINTENANCE_STRATEGY=v1
ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_FOUR_TUBE_HEALTH_INTERPRETATION=v1
ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_LEAKAGE_BURST_ANALYSIS=v1
ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_CUSTOM=v1

# v2 叙述类槽位（llm_narrative）同时调用的 LLM 路数上限（Semaphore）；表/图槽位不受此限
#   过大易占满 vLLM 并发导致排队或 OOM，过小则总耗时变长；默认 3
ANALYSIS_SYNTHESIS_V2_MAX_PARALLEL_LLM=8

# v2 每个叙述槽位单次 chat/stream 的 max_tokens（单章输出上限，非整报告）
#   章节多时可适当加大；默认 4096
# ANALYSIS_SYNTHESIS_V2_SEGMENT_MAX_TOKENS=4096

# v2 程序渲染 Markdown 表（table_deterministic 槽）每个表最多展示行数，超出在文末注明截断
#   默认 80
# ANALYSIS_SYNTHESIS_V2_TABLE_MAX_ROWS=80
# ---------- synthesis v2（多槽位；默认 v1 保持现网）见 docs/综合分析优化版本实现方案(v2版本).md [结束]----------

# ANALYSIS_STRICT_BY_DEFAULT=false

# acquire_data（`AnalysisGraphRunner._execute_data_plan`）：同 dependency 层并行发起 NL2SQLService.query（单任务内仍为串行闭环）
# | ANALYSIS_NL2SQL_ACQUIRE_PARALLEL_ENABLED | 是否启用同层并行 | `true`\|`false`，默认 true；false 时整段串行 |
# | ANALYSIS_NL2SQL_ACQUIRE_MAX_PARALLEL | 同层最大并发 query 数 | 整数 ≥1，默认 8（Semaphore） |
# ANALYSIS_NL2SQL_ACQUIRE_PARALLEL_ENABLED=true
# ANALYSIS_NL2SQL_ACQUIRE_MAX_PARALLEL=8

# 规划前 RAG（`plan_context_rag`）检索句：`legacy` | `user_only` | `cn_label_prefix` | `two_stage`（默认 two_stage：向量/关键词用用户 query，Hybrid 重排用中文场景标签+query）
# ANALYSIS_PLAN_RAG_QUERY_MODE=two_stage

###########看图诊断独立配置部分(均有默认值，默认开启)#######################################################################################
# 看图诊断（`/analysis/run-img-diag`、`/analysis/img-diag/upload`）：视觉臂复用上方 LLM_DEFAULT_MODEL（须为多模态 VL，与 vllm-deploy served_model_name 一致）
# ANALYSIS_IMG_DIAG_VISION_TIMEOUT_SECONDS=120
# 视觉臂 temperature，默认与 CHATBOT_MAIN_LLM_TEMPERATURE 对齐（0.45）
# ANALYSIS_IMG_DIAG_VISION_TEMPERATURE=0.45
# 视觉臂 system 前缀：复用 chatbot 模板（默认跟随 CHATBOT_PROMPT_DEFAULT_VERSION=boiler_v1）
# ANALYSIS_IMG_DIAG_VISION_CHATBOT_PROMPT_VERSION=boiler_v1
# 视觉臂 user 固定短句（不使用缺陷识别/泄爆分析业务 query；位置/处置留给 NL2SQL 与 synthesis）
# ANALYSIS_IMG_DIAG_VISION_USER_QUERY_DEFECT_IDENT=请帮我分析图片缺陷
# ANALYSIS_IMG_DIAG_VISION_USER_QUERY_LEAKAGE_BURST=请分析图片中的爆口/泄漏可见形貌特征。
# ANALYSIS_IMG_DIAG_LANE_TIMEOUT_SECONDS=180
# ANALYSIS_IMG_DIAG_UPLOAD_MAX_MB=15
# 视觉臂：与智能客服看图策略对齐（system+短 query+图、CHATBOT 图片预处理、temperature 默认 0.45）；直接输出 JSON
# 缺陷识别 RAG：vision_augmented（默认）| hybrid（并行预检+视觉增强合并）| parallel（仅问题预检，不含视觉）
ANALYSIS_IMG_DIAG_RAG_MODE=vision_augmented
# 看图诊断 scope 人机协同（LangGraph HITL，在视觉/NL2SQL 并行臂之前确认机组与受热面）
# | 变量 | 作用 |
# | ANALYSIS_IMG_DIAG_USE_LANGGRAPH | 是否启用 scope 子图；false 时跳过 HITL，走原 asyncio 编排 |
# | ANALYSIS_IMG_DIAG_SCOPE_HITL_ENABLED | 是否启用 scope 两层人机协同（LLM 解析 + 库表校验） |
# | ANALYSIS_IMG_DIAG_SCOPE_HITL_MAX_ROUNDS | 人机循环上限（缺字段/校验失败合计 interrupt 次数） |
# | ANALYSIS_IMG_DIAG_SCOPE_MATCHED_CONFIRM_ENABLED | 首次解析+库表均成功时强制一次「匹配成功请确认」；曾 HITL 后不再重复 |
# | ANALYSIS_IMG_DIAG_SCOPE_LOW_CONFIDENCE_HITL | （已废弃，保留兼容）低置信度不再单独触发 HITL |
#
# --- 第二层库表 existence 校验 SQL（ANALYSIS_IMG_DIAG_SCOPE_VALIDATE_SQL）---
# 格式要求：
#   1) .env 中须写成单行；整段用双引号包裹（内含单引号 '' 时安全）。
#   2) 必须保留占位符 :boiler、:device_name；可选 :check_location_name、:row_no、:tube_no（程序 bind 后执行）。
#   3) 必须返回列名 record_count（COUNT 别名）；>0 视为范围在账册/检测位置中存在。
#   4) 机组 account_boiler；受热面 overhaul_new_checklocation.name（onc_surface）；检测位置子节点 parent_id=onc_surface.id；
#      排/管 base_temp_point（device_id=onc_surface.device_id）。不再依赖 account_static_device 台账。
#   5) 两轮人机确认后仍无匹配时，程序按 管数→排数→检测位置 逐级放宽并重试；仅机组+受热面仍无匹配则再次 HITL。
#   6) 若删除本变量或留空，代码回落内置默认（见 img_diag_scope_validate.py）。
# 多行写法（docker-compose / K8s）：可用 | 块或 \n 转义；修改后重启 app 生效。
ANALYSIS_IMG_DIAG_SCOPE_VALIDATE_SQL="SELECT COUNT(*) AS record_count FROM account_boiler ab INNER JOIN overhaul_new_checklocation onc_surface ON onc_surface.boiler_id = ab.boiler_id AND IFNULL(onc_surface.del_flag,0)=0 AND onc_surface.name LIKE CONCAT('%', :device_name, '%') WHERE ab.boiler_name = :boiler AND (:check_location_name IS NULL OR EXISTS (SELECT 1 FROM overhaul_new_checklocation onc_loc WHERE onc_loc.parent_id = onc_surface.id AND IFNULL(onc_loc.del_flag,0)=0 AND onc_loc.name LIKE CONCAT('%', :check_location_name, '%'))) AND (:row_no IS NULL OR EXISTS (SELECT 1 FROM base_temp_point btp WHERE btp.device_id = onc_surface.device_id AND IFNULL(btp.row_num,0)=:row_no AND (:tube_no IS NULL OR IFNULL(btp.pipe_num,0)=:tube_no))) AND (:tube_no IS NULL OR :row_no IS NOT NULL OR EXISTS (SELECT 1 FROM base_temp_point btp2 WHERE btp2.device_id = onc_surface.device_id AND IFNULL(btp2.pipe_num,0)=:tube_no))"
# 校验 SQL 执行超时（秒）；连接/语法失败见 ANALYSIS_IMG_DIAG_SCOPE_VALIDATE_SKIP_ON_ERROR
ANALYSIS_IMG_DIAG_SCOPE_VALIDATE_TIMEOUT_S=10
# true：DB 异常时跳过校验继续（degrade）；false：视为校验失败并回流人机
ANALYSIS_IMG_DIAG_SCOPE_VALIDATE_SKIP_ON_ERROR=false
#
# --- HITL 持久化（多 worker 须 redis；依赖全局 REDIS_URL 或下方独立 URL）---
# | ANALYSIS_IMG_DIAG_CHECKPOINT_BACKEND | LangGraph interrupt 断点：memory | redis |
# | ANALYSIS_IMG_DIAG_SESSION_STORE_BACKEND | resume_token 存储：memory | redis |
# 已配置 REDIS_URL 或 APP_ENV=production 时，代码默认 redis；本文件显式指定如下：
# 生产多 worker 须安装 langgraph-checkpoint-redis（见 requirements-大模型应用.txt）
ANALYSIS_IMG_DIAG_USE_LANGGRAPH=true
ANALYSIS_IMG_DIAG_SCOPE_HITL_ENABLED=true
ANALYSIS_IMG_DIAG_SCOPE_HITL_MAX_ROUNDS=5
# 首次解析+库表均成功时强制一次「匹配成功请确认」人机协同（false=直通；默认 true）
ANALYSIS_IMG_DIAG_SCOPE_MATCHED_CONFIRM_ENABLED=true
# scope 库表校验失败时是否自动放宽管数/排数/检测位置（false=不放宽仅人机协同修正，默认 false）
# ANALYSIS_IMG_DIAG_SCOPE_AUTO_RELAX_ENABLED=false
ANALYSIS_IMG_DIAG_SCOPE_LOW_CONFIDENCE_HITL=true
ANALYSIS_IMG_DIAG_CHECKPOINT_BACKEND=redis
# 可选：与 REDIS_URL 不同 DB，避免与摄入队列等 key 冲突（例 redis://redis:6379/3）
# ANALYSIS_IMG_DIAG_CHECKPOINT_REDIS_URL=redis://redis:6379/3
ANALYSIS_IMG_DIAG_CHECKPOINT_NAMESPACE=img_diag
ANALYSIS_IMG_DIAG_SESSION_STORE_BACKEND=redis
# ANALYSIS_IMG_DIAG_SESSION_STORE_REDIS_URL=redis://redis:6379/3
# resume_token / scope HITL 断点 TTL（秒）；Path1 视觉预取结果一并存储，默认 48h  -- 人机协同状态超时时间
ANALYSIS_IMG_DIAG_SESSION_TTL_SECONDS=172800
# scope resume SSE 空闲保活（秒）：长时间 scope/gather 期间发送 `: ping` comment；0=关闭
# ANALYSIS_IMG_DIAG_RESUME_SSE_IDLE_PING_SECONDS=12
# 单机调试且无 Redis：可改为 ANALYSIS_IMG_DIAG_CHECKPOINT_BACKEND=memory 与 SESSION_STORE_BACKEND=memory
# 缺陷识别 plan/synthesis 模板版本（与 configs/prompts.yaml 中 v1 对齐）
# ANALYSIS_PLAN_TEMPLATE_VERSION_IMG_DIAG_DEFECT_IDENT=v1
# ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_IMG_DIAG_DEFECT_IDENT=v1
# ANALYSIS_PLAN_TEMPLATE_VERSION_IMG_DIAG_LEAKAGE_BURST=v1
# ANALYSIS_SYNTHESIS_TEMPLATE_VERSION_IMG_DIAG_LEAKAGE_BURST=v1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# B. Trace 归档（`ANALYSIS_TRACE_*`；`GET /analysis/traces*` 数据源）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# | 变量 | 作用 | 取值范围 / 说明 |
# |------|------|----------------|
# | ANALYSIS_TRACE_BACKEND | 归档实现 | `redis` \| `memory` \| `es`；别名 `easysearch`/`elasticsearch`→内部按 `es` |
# | ANALYSIS_TRACE_TTL_MINUTES | 记录生存时间 | 分钟，整数 ≥10；Redis 为 key TTL；ES 为文档字段 `expires_at_ms` |
# | ANALYSIS_TRACE_MAX_ITEMS | 索引裁剪规模 | 整数 ≥100；**仅 Redis** ZSET 与类型索引裁剪；ES 不按此项自动删索引 |
# | ANALYSIS_TRACE_TREND_CACHE_TTL_SECONDS | 趋势 API 进程内缓存 | 秒，≥1；见 `AnalysisService.get_trace_trend` |
# | ANALYSIS_TRACE_LAZY_CLEANUP_BATCH_SIZE | Redis 孤儿索引清理批量 | 整数 ≥20；`_lazy_cleanup_orphans` |
# | ANALYSIS_TRACE_ES_* | ES/EasySearch 连接 | `backend=es` 时生效；hosts 逗号分隔；认证与 `RAG_ES_*` 可回落共用 |
# redis 依赖全局 `REDIS_URL`（同文件其它区）；memory 仅单机调试。
# ANALYSIS_TRACE_BACKEND=redis
# ANALYSIS_TRACE_TTL_MINUTES=1440
# ANALYSIS_TRACE_MAX_ITEMS=10000
# ANALYSIS_TRACE_TREND_CACHE_TTL_SECONDS=30
# ANALYSIS_TRACE_LAZY_CLEANUP_BATCH_SIZE=200
# ANALYSIS_TRACE_ES_HOSTS=http://localhost:9200
# ANALYSIS_TRACE_ES_INDEX=analysis_trace_archive
# ANALYSIS_TRACE_ES_VERIFY_CERTS=false
# ANALYSIS_TRACE_ES_TIMEOUT_SECONDS=10
# ANALYSIS_TRACE_ES_USERNAME=
# ANALYSIS_TRACE_ES_PASSWORD=
# ANALYSIS_TRACE_ES_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# C. 质量门阈值（[0,1] 浮点，`AnalysisConfig` 加载时钳制到合理区间；用于 strict）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# | 变量 | 作用 | 典型语义 |
# |------|------|----------|
# | ANALYSIS_PAYLOAD_* | payload 模式 | 时间窗覆盖率下限、数值异常率上限、关键字段缺失率上限；`_evaluate_payload_quality` |
# | ANALYSIS_NL2SQL_* | nl2sql 模式 | 同上 + 全失败/关键步骤失败等；`_evaluate_nl2sql_quality` |
# ANALYSIS_PAYLOAD_TIME_WINDOW_COVERAGE_MIN=0.6
# ANALYSIS_PAYLOAD_ANOMALY_RATE_MAX=0.2
# ANALYSIS_PAYLOAD_MISSING_KEY_RATE_MAX=0.3
# ANALYSIS_NL2SQL_TIME_WINDOW_COVERAGE_MIN=0.5
# ANALYSIS_NL2SQL_ANOMALY_RATE_MAX=0.25
# ANALYSIS_NL2SQL_MISSING_KEY_RATE_MAX=0.35

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# D. NL2SQL 路径 · LLM 分阶段规划（`AnalysisGraphRunner._nl2sql_run_intent_llm` / `_nl2sql_run_plan_llm`）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# | 变量 | 作用 | 取值 |
# |------|------|------|
# | ANALYSIS_NL2SQL_LLM_PLANNER_ENABLED | 是否跑意图+数据计划两阶段 LLM | `true`\|`false`；false 时图节点仍执行但走降级逻辑，仅用 `analysis_plan_*` 与内置默认 |
# =true时要走意图和计划LLM(对应提示词模板中的analysis_intent_overheat_guidance、analysis_data_plan_overheat_guidance)，对应的数据计划(生成sql)是意图和计划LLM输出 + analysis_plan_overheat_guidance
# =false时不走意图和计划LLM，对应的数据计划(生成sql)主要是analysis_plan_overheat_guidance
ANALYSIS_NL2SQL_LLM_PLANNER_ENABLED=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# E. LangGraph checkpoint（`AnalysisGraphRunner._build_analysis_checkpointer`）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# | 变量 | 作用 | 取值 / 依赖 |
# |------|------|-------------|
# | ANALYSIS_CHECKPOINT_BACKEND | 图状态后端 | `none`\|`memory`\|`redis`；非法或依赖缺失→等价 none |
# | ANALYSIS_CHECKPOINT_REDIS_URL | RedisSaver 连接串 | 仅 `backend=redis` 时必填；可与 `REDIS_URL` 不同 DB |
# | ANALYSIS_CHECKPOINT_NAMESPACE | 逻辑命名空间 | 字符串；日志与运维区分业务 |
# 每次请求独立 `thread_id`（`run_with_*` 内 `analysis:payload:{uuid}` / `analysis:nl2sql:{uuid}`），元数据进 `trace.execution_summary`。
# ANALYSIS_CHECKPOINT_BACKEND=none
# ANALYSIS_CHECKPOINT_REDIS_URL=redis://redis:6379/2
# ANALYSIS_CHECKPOINT_NAMESPACE=analysis_graph

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# F. 与综合分析相关的 RAG 检索参数（`app/core/config.py` → `RAGSceneProfilesConfig`）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 下列变量 **不是** `ANALYSIS_` 前缀，但被 `AnalysisGraphRunner` 间接使用：
#   - `RAG_SCENE_NL2SQL_*`：`scene="nl2sql"`，用于「规划前」检索（`_retrieve_plan_rag` → `plan_context_rag` 节点）。
#   - `RAG_SCENE_ANALYSIS_*`：`scene="analysis"`，用于「结论前」业务 RAG（`_retrieve_business_rag` → `rag_enrichment` 节点）。
# 默认值见本文件「RAG 场景化 TopK」小节；与 `HybridRAGService` / `RAGService._get_scene_profile` 对齐。

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# G2. 综合分析智能体 analysis_agent（`app/analysis_agent/`，路由 `/analysis-agent/*`）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 与现网 `/analysis`（`AnalysisGraphRunner`）独立：报告章节见 `configs/analysis_agent_reports/*.json`，
# 数据计划 / 章节合成见 `configs/prompts.yaml` 中 `analysis_agent_plan_*`、`analysis_agent_synthesis_*`。
# 联调页：`tests/web/analysis-agent-stream.html`。
#
# | 变量 | 作用 | 取值 / 说明 |
# |------|------|-------------|
# | ANALYSIS_AGENT_ENABLED | 总开关 | `true`\|`false`；false 时 `/analysis-agent/*` 不可用 |
# | ANALYSIS_AGENT_USE_LANGGRAPH | 是否用 LangGraph 编排 | `true`\|`false`；false 时图 runner 降级 |
# | ANALYSIS_AGENT_USE_REACT_AGENT | 章节合成是否走 ReAct | 默认 `false`；仅 `use_emit_tools` 章生效 |
# | ANALYSIS_AGENT_NARRATIVE_STREAMING | 叙述章真流式 summary_delta | 默认 `true`；false 时回退假切片 |
# | ANALYSIS_AGENT_PLAN_TEMPLATE_VERSION | 逻辑 plan 模板版本 | 默认 `analysis_agent_v1`；写入 trace 并传入 NL2SQL QA 五元组 `plan_template_version`，与现网 `/analysis` 的 v1/v2 隔离。报告 JSON 加载顺序：`{type}.{本变量}.json` → `{type}.analysis_agent.json`（兜底） |
# | ANALYSIS_AGENT_CHECKPOINT_BACKEND | LangGraph checkpoint | `none`\|`memory`\|`redis`；`APP_ENV=production` 且未显式配置时默认 `redis` |
# | ANALYSIS_AGENT_CHECKPOINT_REDIS_URL | checkpoint Redis | 仅 `backend=redis`；缺省回落 `REDIS_URL` |
# | ANALYSIS_AGENT_CHECKPOINT_NAMESPACE | checkpoint 命名空间 | 字符串，默认 `analysis_agent` |
# | ANALYSIS_AGENT_SESSION_STORE_BACKEND | HITL resume_token 存储 | `memory`\|`redis`；多 worker / 跨进程续流须 `redis` |
# | ANALYSIS_AGENT_SESSION_STORE_REDIS_URL | session Redis | 仅 `backend=redis`；缺省回落 `REDIS_URL` |
# | ANALYSIS_AGENT_SESSION_TTL_SECONDS | resume 会话 TTL | 秒，≥60；过期后 `resume-stream` 无效 |
# | ANALYSIS_AGENT_ENABLE_HUMAN_IN_THE_LOOP | 缺数 HITL（T1 主路径已去掉） | 默认 `false`；true 仅兼容旧 resume，编排不再 interrupt |
# | ANALYSIS_AGENT_ACQUIRE_MAX_PARALLEL | 全量 acquire_data 并行度 | 整数 ≥1；按 dependency 分层同层并行 |
# | ANALYSIS_AGENT_ACQUIRE_MAX_RETRIES | 全量取数质量门重试 | 整数 ≥0；缺省回落 SLOT_NL2SQL_MAX_RETRIES |
# | ANALYSIS_AGENT_SLOT_NL2SQL_MAX_RETRIES | （兼容）acquire 重试兜底 | 整数 ≥0 |
# | ANALYSIS_AGENT_SLOT_SYNTH_MAX_RETRIES | 单章合成重试 | 整数 ≥0 |
# | ANALYSIS_AGENT_REACT_MAX_ITERATIONS | ReAct 最大轮次 | 整数 ≥1 |
# | ANALYSIS_AGENT_STREAM_CHUNK_CHARS | SSE 文本分块大小 | 整数 ≥1；`summary_delta` 等流式推送 |
# | ANALYSIS_AGENT_RAG_TOP_K | 业务 RAG TopK | 整数 ≥1；章节合成前检索条数 |
# | ANALYSIS_AGENT_GATHERED_JSON_MAX_CHARS | 取数 JSON 截断上限 | 字符数，≥1000；注入 LLM 的 gathered 数据 |
# | ANALYSIS_AGENT_NARRATIVE_MAX_TOKENS | 章节合成 max_tokens | 整数 ≥256 |
# | ANALYSIS_AGENT_NL2SQL_DISABLE_QA_SLOT_REPLAY | 禁用 QA 槽位回放 | 默认 `true`；打穿到 `NL2SQLQueryRequest.disable_qa_slot_replay` / chain |
# | ANALYSIS_AGENT_QUALITY_PROFILE | 质量门强度 | `light`\|`strict_like`；L1 锚点检查；strict_like+options.strict 可因缺锚点失败 |
# | ANALYSIS_AGENT_ENABLE_STRUCTURED_SSE | 结构化 SSE 事件 | `true`\|`false`；`table_payload` / `chart_payload` 等 |
# | ANALYSIS_AGENT_CHAPTER_SYNTH_MAX_PARALLEL | 章合同并行度 | 默认 `1`（串行）；上限 3；并行时缓冲合成后再按序 emit（保 SSE 序） |
# | ANALYSIS_AGENT_TRACE_BACKEND | 运行 trace 归档 | `memory`\|`redis`\|`elasticsearch`/`easysearch`；生产默认 `redis`（`APP_ENV=production`）；独立前缀 `analysis_agent:trace:*` |
# | ANALYSIS_AGENT_TRACE_TTL_MINUTES | trace 保留时间 | 分钟，≥10 |
# | ANALYSIS_AGENT_TRACE_MAX_ITEMS | trace 最大条数 | 整数 ≥100；memory/redis 裁剪用 |
# | ANALYSIS_AGENT_TRACE_ES_HOSTS | ES/EasySearch 地址 | 逗号分隔；缺省回退 ANALYSIS_TRACE_ES_HOSTS / RAG_ES_HOSTS |
# | ANALYSIS_AGENT_TRACE_ES_INDEX | ES 索引名 | 默认 `analysis_agent_trace_archive`（与现网 analysis_trace 隔离） |
# | — | Trace API | `GET /analysis-agent/traces`、`/traces/stats`、`/traces/trend`、`/traces/degrade-topn`、`/trace/{id}` |

# —— 总开关与编排 ——
ANALYSIS_AGENT_ENABLED=true
ANALYSIS_AGENT_USE_LANGGRAPH=true
ANALYSIS_AGENT_USE_REACT_AGENT=false
ANALYSIS_AGENT_NARRATIVE_STREAMING=true

# —— 逻辑 plan 版本（NL2SQL QA 去重键；报告/plan 模板版本对齐）——
ANALYSIS_AGENT_PLAN_TEMPLATE_VERSION=analysis_agent_v1

# —— LangGraph checkpoint ——
# 开发默认 memory；生产多实例请改为 redis（见下方注释示例）
ANALYSIS_AGENT_CHECKPOINT_BACKEND=memory
ANALYSIS_AGENT_CHECKPOINT_NAMESPACE=analysis_agent
# ANALYSIS_AGENT_CHECKPOINT_BACKEND=redis
# ANALYSIS_AGENT_CHECKPOINT_REDIS_URL=redis://redis:6379/3

# —— resume_token 会话（兼容 HITL；T1 主路径无缺数 interrupt）——
# ANALYSIS_AGENT_SESSION_STORE_BACKEND=redis
# ANALYSIS_AGENT_SESSION_STORE_REDIS_URL=redis://redis:6379/3
ANALYSIS_AGENT_SESSION_TTL_SECONDS=3600

# —— 取数并行 / 质量门重试（T1：全量 acquire_data，无缺数 HITL）——
ANALYSIS_AGENT_ENABLE_HUMAN_IN_THE_LOOP=false
ANALYSIS_AGENT_ACQUIRE_MAX_PARALLEL=8
ANALYSIS_AGENT_ACQUIRE_MAX_RETRIES=2
ANALYSIS_AGENT_CHAPTER_SYNTH_MAX_PARALLEL=1
ANALYSIS_AGENT_SLOT_NL2SQL_MAX_RETRIES=2
ANALYSIS_AGENT_SLOT_SYNTH_MAX_RETRIES=1
ANALYSIS_AGENT_REACT_MAX_ITERATIONS=8

# —— 流式输出与 RAG / LLM 上下文 ——
ANALYSIS_AGENT_STREAM_CHUNK_CHARS=256
ANALYSIS_AGENT_RAG_TOP_K=8
ANALYSIS_AGENT_GATHERED_JSON_MAX_CHARS=12000
ANALYSIS_AGENT_NARRATIVE_MAX_TOKENS=4096

# —— NL2SQL QA 与 SSE / 质量门 ——
ANALYSIS_AGENT_NL2SQL_DISABLE_QA_SLOT_REPLAY=true
ANALYSIS_AGENT_QUALITY_PROFILE=light
ANALYSIS_AGENT_ENABLE_STRUCTURED_SSE=true

# —— 运行 trace（T6；独立于现网 ANALYSIS_TRACE_*；多 worker 生产用 redis）——
# ANALYSIS_AGENT_TRACE_BACKEND=memory
# ANALYSIS_AGENT_TRACE_BACKEND=redis
# ANALYSIS_AGENT_TRACE_BACKEND=elasticsearch
# ANALYSIS_AGENT_TRACE_TTL_MINUTES=1440
# ANALYSIS_AGENT_TRACE_MAX_ITEMS=5000
# ANALYSIS_AGENT_TRACE_ES_HOSTS=http://localhost:9200
# ANALYSIS_AGENT_TRACE_ES_INDEX=analysis_agent_trace_archive
# 列表/统计：GET /analysis-agent/traces、/traces/stats、/traces/trend、/traces/degrade-topn
# 单条：GET /analysis-agent/trace/{request_id} 或 /traces/{request_id}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# G3. 数据查询智能体（data_query_agent / `/data-query-agent/*`）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 查询台取数走 NL2SQL 地降业务域，进程须设置：NL2SQL_BUSINESS_DOMAIN=subsidence
# （可与综合分析报告同进程；未设则锁表/语义层不按七库监测表工作）。
# | DATA_QUERY_AGENT_ENABLED | 总开关 | 默认 `true`；`false` 时路由 503 |
# Java 默认表补拉 HUD：GET /data-query-agent/hud?library_id=&entity_type=&entity_id=（解析路径用 SSE 一组数据，不要打该接口）
# | DATA_QUERY_AGENT_CHECKPOINT_BACKEND | HITL checkpointer | 默认 `redis`；无 Redis 本地/单测可设 `memory` |
# | DATA_QUERY_AGENT_SESSION_STORE_BACKEND | resume_token | 默认 `redis`；无 Redis 本地/单测可设 `memory` |
# | DATA_QUERY_AGENT_LIBRARY_LLM_ENABLED | 规则未命中时 LLM 补召回 | 默认 `true`；单测可关 |
# | DATA_QUERY_AGENT_TRACE_BACKEND | trace | 默认 `redis`（键前缀 data_query_agent:trace:*）；无 Redis 回落 memory |
# | DATA_QUERY_AGENT_TRACE_TTL_MINUTES | trace TTL | 默认 1440 |
# | DATA_QUERY_AGENT_HUD_LAYER_ENABLED | 层位 HUD | 默认 `false`（无表则永不点亮） |
# | DATA_QUERY_AGENT_STRATEGY_BLOCK_ENABLED | 防灾策略块 | 默认 `false` |
# | DATA_QUERY_AGENT_ACQUIRE_MAX_PARALLEL | q_list / q_hud_series 并行 | 默认 2 |
# | DATA_QUERY_AGENT_HUD_MAX_STATIONS | HUD 站数上限 | 默认 50 |
# | DATA_QUERY_AGENT_HUD_MAX_DISTRICTS | HUD 区数上限 | 默认 16 |
# | DATA_QUERY_AGENT_HUD_MAX_POINTS_PER_STATION | 每实体时序点数 | 默认 200 |
# | DATA_QUERY_AGENT_HUD_CITY_ENABLED | 全市行 HUD | 默认 `true` |
# | DATA_QUERY_AGENT_DEFAULT_MAX_ROWS | 列表 LIMIT | 默认 500 |
# | DATA_QUERY_AGENT_LIBRARIES_FILE | 库注册表 | `configs/data_query_agent/libraries.yaml` |

DATA_QUERY_AGENT_ENABLED=true
DATA_QUERY_AGENT_CHECKPOINT_BACKEND=redis
DATA_QUERY_AGENT_SESSION_STORE_BACKEND=redis
DATA_QUERY_AGENT_LIBRARY_LLM_ENABLED=true
DATA_QUERY_AGENT_TRACE_BACKEND=redis
DATA_QUERY_AGENT_TRACE_TTL_MINUTES=1440
DATA_QUERY_AGENT_HUD_LAYER_ENABLED=false
DATA_QUERY_AGENT_STRATEGY_BLOCK_ENABLED=false
DATA_QUERY_AGENT_ACQUIRE_MAX_PARALLEL=2
DATA_QUERY_AGENT_HUD_MAX_STATIONS=50
DATA_QUERY_AGENT_HUD_MAX_DISTRICTS=16
DATA_QUERY_AGENT_HUD_MAX_POINTS_PER_STATION=200
DATA_QUERY_AGENT_HUD_CITY_ENABLED=true
DATA_QUERY_AGENT_DEFAULT_MAX_ROWS=500
DATA_QUERY_AGENT_HITL_MAX_RETRIES=5
DATA_QUERY_AGENT_LIBRARIES_FILE=configs/data_query_agent/libraries.yaml
# DATA_QUERY_AGENT_CHECKPOINT_REDIS_URL=redis://redis:6379/3
# DATA_QUERY_AGENT_SESSION_STORE_BACKEND=redis

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# G. 提示词与鉴权（非 ANALYSIS_ 前缀，但与综合分析联调强相关）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# - 综合分析模板文件：默认 `configs/prompts.yaml`（顶级键 = `PromptTemplateRegistry` 的 scene；详见该文件头部注释）。
#   扩展数据计划请增加/修改 `analysis_plan_<analysis_type>` JSON 数组；LLM 分阶段见 `analysis_intent` / `analysis_data_plan`。
# - HTTP 鉴权：`/analysis/*` 与其它 API 相同，请求头 `Authorization: Bearer <SERVICE_API_KEY>`（见本文件 SERVICE_API_KEY 及部署说明）。
# - NL2SQL 主链路 SQL 生成使用 prompts 中 `nl2sql` 段，默认版本见 `NL2SQL_PROMPT_DEFAULT_VERSION`（chatbot 区附近注释）。
