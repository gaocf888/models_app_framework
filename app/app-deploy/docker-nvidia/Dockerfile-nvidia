# =============================================================================
# 英伟达 GPU 在线应用镜像：大模型应用依赖 + CUDA PyTorch（嵌入 / 重排 GPU 推理）
# =============================================================================
# 构建上下文（context）：必须是仓库根目录 models_app_framework
#   docker compose -f app/app-deploy/docker-nvidia/docker-compose-nvidia.yml build
#
# 与 app/app-deploy/Dockerfile（CPU）对比：
#   - 先安装 PyTorch cu121 官方轮子，再 pip install 业务 requirements，
#     避免 sentence-transformers 等将 torch 替换为 CPU 版。
#   - 不含 Ultralytics / 小模型通道依赖（见 Dockerfile.small-model-gpu）。
#
# 与 app/app-deploy/docker-mx/Dockerfile-mx（沐曦）对比：
#   - 沐曦使用 Metax vllm-metax 基础镜像 + conda Python；
#   - 本文件使用 python:3.11-slim + pip cu121 torch，适配 NVIDIA + Container Toolkit。
#
# 前置：宿主机 NVIDIA 驱动 + NVIDIA Container Toolkit；compose 注入 NVIDIA_VISIBLE_DEVICES。
# 若驱动与 cu121 不兼容：可改用 cu118/cu124 的 PyTorch 索引 URL，并在此文件统一修改。
# =============================================================================

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace \
    PIP_DEFAULT_TIMEOUT=300

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libglib2.0-0 libsm6 libxext6 libgl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121

# 先固定 CUDA 版 PyTorch，再装业务依赖（与 Dockerfile.small-model-gpu 策略一致）
RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir --timeout=300 --retries=15 \
        torch torchvision \
        --index-url ${TORCH_INDEX_URL}

COPY requirements-大模型应用.txt /workspace/requirements-app.txt
COPY requirements-人脸识别-CPU.txt /workspace/requirements-face-cpu.txt
RUN pip install --no-cache-dir --timeout=300 --retries=15 \
        ${PIP_INDEX_URL:+-i} ${PIP_INDEX_URL:+$PIP_INDEX_URL} \
        ${PIP_TRUSTED_HOST:+--trusted-host} ${PIP_TRUSTED_HOST:+$PIP_TRUSTED_HOST} \
        -r /workspace/requirements-app.txt -r /workspace/requirements-face-cpu.txt

COPY app /workspace/app
COPY configs /workspace/configs

EXPOSE 8083

# 生产 worker 数由 compose command 传入；使用 python -m uvicorn 与镜像内 Python 一致
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8083"]
