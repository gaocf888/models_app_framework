{
  "mcpServers": {
    "basic-memory": {
      "command": "C:\\Users\\gao_c\\.local\\bin\\uvx.exe",
      "args": [
        "basic-memory",
        "mcp",
        "--project",
        "models_app_framework",
        "--data-dir",
        "${workspaceFolder}/.basic-memory"
      ]
    },
    "mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "YOUR_MYSQL_PASSWORD",
        "MYSQL_DB": "your_database",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--transport",
        "stdio",
        "--dsn",
        "postgresql://postgres:1qaz%404321@124.222.37.179:5432/dmcj"
      ]
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "chrome-devtools-auto": {
      "command": "cmd",
      "args": [
        "/c", "npx", "-y", "chrome-devtools-mcp@latest",
        "--autoConnect=true"
      ]
    }
  }
}
