# ---------- 关键配置项说明 ----------
# 针对不同显卡/加速卡的硬件监控（node-exporter 不含 GPU/NPU；按现场卡型二选一启用）
# 1. COMPOSE_PROFILES: 启用对应 exporter
#      英伟达 → gpu-nvidia（DCGM，看板 06）
#      昇腾   → gpu-ascend（npu-exporter，看板 07）
#      沐曦 / 寒武纪 / 其它 → 本仓库未内置，须单独增加 exporter + scrape + 看板
# 2. 英伟达：DCGM_EXPORTER_IMAGE / NVIDIA_RUNTIME / NVIDIA_VISIBLE_DEVICES（一般默认即可）
# 3. 昇腾：ASCEND_NPU_EXPORTER_IMAGE（须与宿主机驱动/MindCluster 版本匹配）/
#         ASCEND_DRIVER_HOST_PATH / ASCEND_DCMI_HOST_PATH（驱动与 DCMI 不在默认路径时再改）

# =============================================================================
# monitoring-deploy 环境变量模板（复制为 monitoring-deploy/.env 后按需修改）
# =============================================================================

# ---- 端口 ----
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
BLACKBOX_PORT=9115
NODE_EXPORTER_PORT=9100

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_Grafana_123!
GF_SERVER_ROOT_URL=http://localhost:3000

# ---- 数据目录（昇腾现场建议 VD1）----
# bind 挂载时必须可被容器内非 root 用户写入，否则 Prometheus 会 panic:
#   open /prometheus/queries.active: permission denied
# 启动前执行: bash scripts/prepare-data-dirs.sh
#   prometheus/alertmanager -> uid 65534 (nobody)
#   grafana                 -> uid 472
PROMETHEUS_DATA_HOST_PATH=/aidata/data/prometheus
GRAFANA_DATA_HOST_PATH=/aidata/data/grafana
ALERTMANAGER_DATA_HOST_PATH=/aidata/data/alertmanager

# ---- Docker 外部网络（须与各业务栈 .env 一致）----
# models-app 与 vllm-service 通常都在该网，便于 DNS scrape
VLLM_DOCKER_NETWORK=docker_vllm-network
RAG_DOCKER_NETWORK=ai-stack
MINERU_DOCKER_NETWORK=mineru-stack

# ---- scrape 目标（容器名:容器内端口；与 compose 一致）----
MODELS_APP_SCRAPE_TARGET=models-app:8083
MODELS_APP_GPU_SCRAPE_TARGET=models-app-gpu:8083
VLLM_SCRAPE_TARGET=vllm-service:8000
MINERU_HEALTH_TARGET=http://mineru-api:8000/health
VLLM_HEALTH_TARGET=http://vllm-service:8000/health
APP_HEALTH_TARGET=http://models-app:8083/health

# 是否抓取 models-app-gpu（未部署时保持 false，避免 target DOWN 噪声）
SCRAPE_MODELS_APP_GPU=false

# Prometheus 保留天数
PROMETHEUS_RETENTION=15d

# Alertmanager Webhook（一期占位；可改为企业微信/钉钉机器人）
ALERTMANAGER_WEBHOOK_URL=http://127.0.0.1:9/dev-null

# ---- GPU / NPU 硬件监控（二选一启用；默认不启；说明见文件最上方「关键配置项说明」）----
# 英伟达：
# COMPOSE_PROFILES=gpu-nvidia
# DCGM_EXPORTER_IMAGE=nvidia/dcgm-exporter:4.8.3
# NVIDIA_RUNTIME=nvidia
# NVIDIA_VISIBLE_DEVICES=all
#
# 昇腾：
# COMPOSE_PROFILES=gpu-ascend
# ASCEND_NPU_EXPORTER_IMAGE=ascendai/npu-exporter:v7.3.2
# ASCEND_DRIVER_HOST_PATH=/usr/local/Ascend/driver
# ASCEND_DCMI_HOST_PATH=/usr/local/dcmi
