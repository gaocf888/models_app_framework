# 应用侧 GraphRAG 接入 Neo4j 的环境模板
#
# 说明：
# - 本文件用于 app/app-deploy 等应用栈接入 Neo4j（GraphRAG）；
# - 部署 Neo4j 自身使用 graphrag_db-deploy/.env + docker-compose.neo4j.yml；
# - 应用进程真正读的是 app/app-deploy/.env 中的 NEO4J_*，本文件可作为那里的“项目级模板”。

# =========================
# 是否启用 GraphRAG（默认关）
# =========================

GRAPH_RAG_ENABLED=false
GRAPH_RAG_INGEST_ON_RAG=false
GRAPH_RAG_DELETE_ON_RAG=false
GRAPH_RAG_MODE=vector

# =========================
# 连接信息（与 graphrag_db-deploy/.env 保持一致）
# =========================

# Bolt URI，容器间推荐使用服务名 / 容器名（假定应用与 Neo4j 在同一 Docker 网络）。
# NEO4J_URI=bolt://graph-neo4j:7687

# 账号与密码：与 Neo4j 容器 NEO4J_AUTH 中的 NEO4J_USERNAME/NEO4J_PASSWORD 相同
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=ChangeMe_123!

# 默认数据库名
# NEO4J_DATABASE=neo4j

# Schema 与 LLM 抽取（默认关 / 默认 llm）
# GRAPH_SCHEMA_CONFIG_PATH=configs/graph_schema.yaml
# GRAPH_SCHEMA_HOT_RELOAD=false
# GRAPH_EXTRACTION_MODE=llm
# GRAPH_EXTRACTION_FALLBACK_RULE=false
# GRAPH_LLM_ENDPOINT=
# GRAPH_LLM_MODEL=
# GRAPH_LLM_TIMEOUT_S=120
# GRAPH_LLM_BATCH_SIZE=4

