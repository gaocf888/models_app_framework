# ---------- 关键配置项说明 ----------
# 1. VLLM_REQUIREMENTS_PROFILE: 依赖配置项（镜像构建时区分不同加速卡安装的python包，Nvidia卡安装全部，国产卡因官方镜像中已预装适配版vLLM/torch 禁止覆盖安装）：
#   full   = 安装 requirements.txt（含 vLLM；**仅英伟达**常用）
#   extras = 仅 requirements-extras.txt（**沐曦/昇腾/寒武纪**：厂商已预装 vLLM/torch 时使用，禁止用 PyPI 覆盖）
# 2. VLLM_PLATFORM: 指定加速卡类型，用于相关适配卡针对性配置
# 3. *_VISIBLE_DEVICES: 可见加速卡配置（指定哪些卡用于vLLM部署）
# 4. TENSOR_PARALLEL_SIZE: 张量并行GPU(NPU)数量
# 5. MODEL_PRESET: 指定部署的模型(与config/models.yaml中配置的模型项对应)
# 6. MODEL_PATH: 大模型权重路径

# 配置优先级1
# 当前vllm-deploy/ 的全部配置文件如下（按照配置生效优先级排序）：
# .env
# config/models.yaml
# config/vllm.yaml

# 环境变量配置模板（复制为 vllm-deploy/.env 后按需修改）
#
# =============================================================================
# 【显卡平台选型总览】先选 VLLM_PLATFORM；底座镜像默认由对应 Dockerfile / compose overlay 提供，一般不必在 .env 写 BASE_IMAGE
# -----------------------------------------------------------------------------
# | 平台        | VLLM_PLATFORM | 默认底座（Dockerfile / overlay）           | 设备可见性变量              | overlay 文件                    |
# |-------------|---------------|-------------------------------------------|-----------------------------|-------------------------------|
# | 英伟达      | nvidia        | Dockerfile-nvidia / compose.nvidia        | CUDA_VISIBLE_DEVICES        | docker-compose.nvidia.yml     |
# | 沐曦(Metax) | mthreads      | Dockerfile-mx / compose.mthreads          | MX_VISIBLE_DEVICES          | docker-compose.mthreads.yml   |
# | 昇腾(Ascend)| ascend        | Dockerfile-ascend（v0.10.0rc1-310p）      | ASCEND_RT_VISIBLE_DEVICES   | docker-compose.ascend.yml     |
# | 寒武纪      | cambricon     | Dockerfile-mx + 厂商镜像                  | MLU_VISIBLE_DEVICES         | docker-compose.cambricon.yml  |
# 仅当需要临时换私有仓库 tag 时再取消注释 BASE_IMAGE=...
# =============================================================================


# --- 英伟达（NVIDIA）示例 ---
# BASE_IMAGE=nvidia/cuda:12.3.0-runtime-ubuntu22.04   # 可选覆盖；默认见 Dockerfile-nvidia
# VLLM_REQUIREMENTS_PROFILE=full
# VLLM_PLATFORM=nvidia
# CUDA_VISIBLE_DEVICES=0
# GPU_DEVICE_COUNT=all
# TENSOR_PARALLEL_SIZE=1

# --- 沐曦（Metax / mthreads）示例 ---
# BASE_IMAGE=cr.metax-tech.com/public-ai-release/maca/vllm-metax:0.17.0-maca.ai3.5.3.307-torch2.8-py312-kylinv11-amd64
# VLLM_REQUIREMENTS_PROFILE=extras
# VLLM_PLATFORM=mthreads
# MX_VISIBLE_DEVICES=0,1
# TENSOR_PARALLEL_SIZE=2

# --- 昇腾（Ascend / Atlas 300I Duo，地面沉降 / 本文默认）---
# 默认底座：Dockerfile-ascend / docker-compose.ascend.yml → quay.io/ascend/vllm-ascend:v0.10.0rc1-310p
# tags：https://quay.io/repository/ascend/vllm-ascend?tab=tags
# 须与宿主机驱动 25.2.0 / 固件 7.7.0.6.236 / 镜像内 CANN 8.2.RC1 配套；勿擅自换「更新」tag
# BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.10.0rc1-310p   # 可选覆盖；一般不必配置
VLLM_REQUIREMENTS_PROFILE=extras
VLLM_PLATFORM=ascend
# 四卡切分 §5：vLLM 占用设备 0,1,2,3（物理卡0+卡1）；更大模型且镜像支持时可 TENSOR_PARALLEL_SIZE=4
ASCEND_RT_VISIBLE_DEVICES=0,1,2,3
TENSOR_PARALLEL_SIZE=2
# Ascend Docker Runtime 名称（默认 ascend；与 daemon.json 中 runtimes.ascend 一致）
# ASCEND_DOCKER_RUNTIME=ascend

# --- 寒武纪（Cambricon）示例 ---
# BASE_IMAGE=<registry>/vllm-mlu:<tag>
# VLLM_REQUIREMENTS_PROFILE=extras
# VLLM_PLATFORM=cambricon
# MLU_VISIBLE_DEVICES=0
# TENSOR_PARALLEL_SIZE=1

# 构建产物镜像名
VLLM_IMAGE=vllm-service:last

# ---------- 运行期 · 模型与服务 ----------
# MODEL_PRESET=qwen2.5-vl-7b
# MODEL_PRESET=qwen2.5-vl-32b
# MODEL_PRESET=qwen2.5-vl-32b-awq
# MODEL_PRESET=qwen2.5-7b
MODEL_PRESET=qwen3-8b

VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# 模型目录挂载（宿主机路径 -> 容器 /workspace/models）
# 默认建议：/aidata/models/llm
MODEL_PATH=/aidata/models/llm

# ---------- 设备可见性（按卡型二选一启用；start.py 会按探测到的设备读对应变量）----------
# - 英伟达(cuda): CUDA_VISIBLE_DEVICES（例如 0 或 0,1）
# - 昇腾(npu):   ASCEND_RT_VISIBLE_DEVICES
# - 寒武纪(mlu): MLU_VISIBLE_DEVICES
# - 沐曦(gcu):   MX_VISIBLE_DEVICES
# - Intel(xpu):  XPU_VISIBLE_DEVICES
# 注意：
# 1) 国产环境可保留 CUDA_VISIBLE_DEVICES，但最终以对应厂商变量为准
# 2) 若未显式设置厂商变量，start.py 默认使用单卡 0
# 3) 同时只应「激活」当前平台那一行（见上方各平台示例块）

# 仅 nvidia 平台使用：占用 GPU 数量（all 或数字）
# GPU_DEVICE_COUNT=all

# GPU_MEMORY_UTILIZATION=0.8
# 此处 MAX_MODEL_LEN 配置注释掉，优先取 config/models.yaml 中的对应模型配置
# MAX_MODEL_LEN=8192

LOG_LEVEL=INFO
# STARTUP_WAIT_TIMEOUT=1200

# 可选：媒体挂载（compose 中 MEDIA_PATH，默认 docker/media）
# MEDIA_PATH=./media

# WORKSPACE=/workspace
