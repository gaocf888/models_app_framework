# 检修 V0 · 沐曦（Metax / MACA）GPU 侧车
# 编排对齐 vllm-deploy/docker/docker-compose.mthreads.yml：privileged + 挂载 /dev + MX_VISIBLE_DEVICES
# 飞桨沐曦安装见：https://www.paddlepaddle.org.cn/documentation/docs/zh/hardware_support/metax/install_cn.html
#
# 默认底镜像：沐曦仓库 **maca/paddle:2.6.0-…-py310-kylinv11-amd64**（麒麟 Kylin V11 + x86_64；已含飞桨 2.6 + MACA，无需再 pip paddle-metax-gpu）。
# ARM64 现场可改用沐曦 **`…-kylinv10-arm64`** 等 tag，并设 `BASE_IMAGE` / `PADDLE_LAYOUT_MT_BASE_IMAGE`；底镜像架构须与宿主机一致，否则首条 RUN 会出现 **exec format error**。
# 若底镜像名为 `paddle-metax` 或路径含 `maca/paddle:`，构建将 **跳过** 飞桨/沐曦插件的 pip 安装。
# DOCX→PDF：apt 分支装官方包；yum/dnf 分支先可选**第三方 repo / 指定 RPM**，再回退麒麟常见包名；均无则 WARN 构建仍过。
# 构建参数（compose 里对应 PADDLE_LAYOUT_LO_*）：`PADDLE_LAYOUT_LO_REPO_URL` 指向可 curl 的 `.repo`（优先于内置源）；
# 未设置 URL 且 `PADDLE_LAYOUT_LO_BUILTIN_CHINA_EPEL=1`（默认）时复制镜像内 `docker/epel-china-el*.repo`（阿里云 EPEL）；
# `PADDLE_LAYOUT_LO_YUM_PACKAGES` 空格分隔包名（一次 yum/dnf 装齐）；`PADDLE_LAYOUT_LO_RPM_URLS` 空格分隔 RPM 直链。
# 若在 vllm-metax（Python 3.12）上自行 pip 沐曦插件，会因无 cp312 wheel 失败——请改用本默认底镜像或设 METAX_PADDLE_GPU=0。
ARG BASE_IMAGE=cr.metax-tech.com/public-ai-release/maca/paddle:2.6.0-maca.ai3.7.0.6-py310-kylinv11-amd64
FROM ${BASE_IMAGE}

# 供 RUN 中判断是否跳过飞桨 pip（须与 build-arg 同名再声明一次）
ARG BASE_IMAGE

# 可选：麒麟官方源无 LibreOffice 时追加 yum 源；默认可启用**内置阿里云 EPEL**（见 docker/epel-china-el*.repo）
ARG PADDLE_LAYOUT_LO_REPO_URL=
# 1（默认）：未设置 LO_REPO_URL 时复制内置阿里云 EPEL repo；0：不启用内置源（仅用麒麟源或下方 URL）
ARG PADDLE_LAYOUT_LO_BUILTIN_CHINA_EPEL=1
# 空格分隔；默认一次安装 EPEL 常见包：无界面套件 + 简体中文语言包（可按现场改包名）
ARG PADDLE_LAYOUT_LO_YUM_PACKAGES="libreoffice-headless libreoffice-langpack-zh-Hans"
# 空格分隔 RPM 直链
ARG PADDLE_LAYOUT_LO_RPM_URLS=
# 1 时 yum/dnf install 追加 --nogpgcheck
ARG PADDLE_LAYOUT_LO_YUM_NOGPGCHECK=0

ARG PIP_INDEX_URL=
# 1=使用沐曦 GPU 飞桨：底镜像为官方 paddle-metax / maca/paddle（已集成）时跳过飞桨 pip；否则在 py310/311 上尝试 pip 安装插件
# 0=强制 pip 安装 paddlepaddle 2.6 CPU（无沐曦 GPU；可用于 py312 底镜像仅跑通 HTTP）
ARG METAX_PADDLE_GPU=1
# 官方文档：nightly + --pre；stable 走固定版本（仅当 pip 解释器为 py310/311 时 maca 索引才可能有包）
# nightly | stable
ARG PADDLE_METAX_CHANNEL=nightly
ARG PADDLE_CPU_METAX_VER=3.3.0
ARG PADDLE_METAX_GPU_VER=3.3.0
ARG PADDLE_CPU_INDEX_NIGHTLY=https://www.paddlepaddle.org.cn/packages/nightly/cpu/
ARG PADDLE_MACA_INDEX_NIGHTLY=https://www.paddlepaddle.org.cn/packages/nightly/maca/
ARG PADDLE_CPU_INDEX_STABLE=https://www.paddlepaddle.org.cn/packages/stable/cpu/
ARG PADDLE_MACA_INDEX_STABLE=https://www.paddlepaddle.org.cn/packages/stable/maca/

ENV PYTHONUNBUFFERED=1 \
    PADDLEOCR_HOME=/io/.paddleocr \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

USER root

COPY docker/epel-china-el8.repo docker/epel-china-el7.repo /tmp/

RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        poppler-utils curl libreoffice-writer-nogui \
      && rm -rf /var/lib/apt/lists/*; \
    elif command -v yum >/dev/null 2>&1; then \
      yum install -y poppler-utils curl && \
      LO_REPO="${PADDLE_LAYOUT_LO_REPO_URL}" && LO_PKGS="${PADDLE_LAYOUT_LO_YUM_PACKAGES}" && LO_RPMS="${PADDLE_LAYOUT_LO_RPM_URLS}" && \
      BUILTIN="${PADDLE_LAYOUT_LO_BUILTIN_CHINA_EPEL:-1}" && \
      NOGPG="" && if [ "${PADDLE_LAYOUT_LO_YUM_NOGPGCHECK}" = "1" ]; then NOGPG="--nogpgcheck"; fi && \
      if [ -n "$LO_REPO" ]; then \
        echo "[paddle-layout] LO: adding repo from PADDLE_LAYOUT_LO_REPO_URL" && \
        curl -fsSL "$LO_REPO" -o /etc/yum.repos.d/paddle-layout-lo.repo && \
        ( yum makecache fast 2>/dev/null || yum makecache 2>/dev/null || true ); \
      elif [ "$BUILTIN" != "0" ] && [ "$BUILTIN" != "false" ] && [ "$BUILTIN" != "no" ]; then \
        RV="$(rpm -E '%{rhel}' 2>/dev/null)" && \
        case "$RV" in 7|8|9) ;; *) RV=8 ;; esac && \
        if [ "$RV" = "7" ]; then \
          echo "[paddle-layout] LO: builtin Aliyun EPEL 7 (rhel=$RV)" && \
          cp /tmp/epel-china-el7.repo /etc/yum.repos.d/paddle-layout-builtin-epel.repo; \
        else \
          echo "[paddle-layout] LO: builtin Aliyun EPEL 8 (rhel=$RV)" && \
          cp /tmp/epel-china-el8.repo /etc/yum.repos.d/paddle-layout-builtin-epel.repo; \
        fi && \
        ( yum makecache fast 2>/dev/null || yum makecache 2>/dev/null || true ); \
      fi && \
      if [ -n "$LO_PKGS" ]; then \
        echo "[paddle-layout] LO: yum install -y $NOGPG $LO_PKGS" && \
        yum install -y $NOGPG $LO_PKGS 2>/dev/null || true; \
      fi && \
      if [ -n "$LO_RPMS" ]; then \
        idx=0; for u in $LO_RPMS; do \
          idx=$((idx+1)); f="/tmp/paddle_lo_${idx}.rpm"; \
          echo "[paddle-layout] LO: fetching RPM $u" && curl -fsSL "$u" -o "$f" && \
          ( rpm -ivh --nodeps "$f" 2>/dev/null || yum install -y $NOGPG "$f" 2>/dev/null || true ) && rm -f "$f"; \
          command -v soffice >/dev/null 2>&1 && break; \
          command -v libreoffice >/dev/null 2>&1 && break; \
        done; \
      fi && \
      ( for pkg in libreoffice-headless libreoffice-writer libreoffice libreoffice-core libreoffice-langpack-zh-Hans; do \
          if yum install -y $NOGPG "$pkg" 2>/dev/null; then echo "[paddle-layout] yum installed $pkg"; break; fi; \
        done; \
        true ) && \
      ( command -v soffice >/dev/null 2>&1 || command -v libreoffice >/dev/null 2>&1 \
        || echo "[paddle-layout] WARN: no LibreOffice in PATH (Kylin repos often omit LO); set LO_REPO_URL / LO_RPM_URLS or disable builtin if EPEL mismatches)." ) && \
      yum clean all; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf install -y poppler-utils curl && \
      LO_REPO="${PADDLE_LAYOUT_LO_REPO_URL}" && LO_PKGS="${PADDLE_LAYOUT_LO_YUM_PACKAGES}" && LO_RPMS="${PADDLE_LAYOUT_LO_RPM_URLS}" && \
      BUILTIN="${PADDLE_LAYOUT_LO_BUILTIN_CHINA_EPEL:-1}" && \
      NOGPG="" && if [ "${PADDLE_LAYOUT_LO_YUM_NOGPGCHECK}" = "1" ]; then NOGPG="--nogpgcheck"; fi && \
      if [ -n "$LO_REPO" ]; then \
        echo "[paddle-layout] LO: adding repo from PADDLE_LAYOUT_LO_REPO_URL" && \
        curl -fsSL "$LO_REPO" -o /etc/yum.repos.d/paddle-layout-lo.repo && \
        ( dnf makecache 2>/dev/null || true ); \
      elif [ "$BUILTIN" != "0" ] && [ "$BUILTIN" != "false" ] && [ "$BUILTIN" != "no" ]; then \
        RV="$(rpm -E '%{rhel}' 2>/dev/null)" && \
        case "$RV" in 7|8|9) ;; *) RV=8 ;; esac && \
        if [ "$RV" = "7" ]; then \
          echo "[paddle-layout] LO: builtin Aliyun EPEL 7 (rhel=$RV)" && \
          cp /tmp/epel-china-el7.repo /etc/yum.repos.d/paddle-layout-builtin-epel.repo; \
        else \
          echo "[paddle-layout] LO: builtin Aliyun EPEL 8 (rhel=$RV)" && \
          cp /tmp/epel-china-el8.repo /etc/yum.repos.d/paddle-layout-builtin-epel.repo; \
        fi && \
        ( dnf makecache 2>/dev/null || true ); \
      fi && \
      if [ -n "$LO_PKGS" ]; then \
        echo "[paddle-layout] LO: dnf install -y $NOGPG $LO_PKGS" && \
        dnf install -y $NOGPG $LO_PKGS 2>/dev/null || true; \
      fi && \
      if [ -n "$LO_RPMS" ]; then \
        idx=0; for u in $LO_RPMS; do \
          idx=$((idx+1)); f="/tmp/paddle_lo_${idx}.rpm"; \
          echo "[paddle-layout] LO: fetching RPM $u" && curl -fsSL "$u" -o "$f" && \
          ( rpm -ivh --nodeps "$f" 2>/dev/null || dnf install -y $NOGPG "$f" 2>/dev/null || true ) && rm -f "$f"; \
          command -v soffice >/dev/null 2>&1 && break; \
          command -v libreoffice >/dev/null 2>&1 && break; \
        done; \
      fi && \
      ( for pkg in libreoffice-headless libreoffice-writer libreoffice libreoffice-core libreoffice-langpack-zh-Hans; do \
          if dnf install -y $NOGPG "$pkg" 2>/dev/null; then echo "[paddle-layout] dnf installed $pkg"; break; fi; \
        done; \
        true ) && \
      ( command -v soffice >/dev/null 2>&1 || command -v libreoffice >/dev/null 2>&1 \
        || echo "[paddle-layout] WARN: no LibreOffice in PATH; set LO_* build-args or use CPU Dockerfile." ) && \
      dnf clean all; \
    fi

WORKDIR /app

COPY service/requirements-base.txt service/requirements-paddleocr.txt /app/service/

# 优先 python3.10（与 maca/paddle、paddle-metax 镜像一致），否则退化为 python3 / python
RUN PY="$(command -v python3.10 || command -v python3 || command -v python)" && echo "Using ${PY}" && "${PY}" --version

RUN set -eux; \
    PY="$(command -v python3.10 || command -v python3 || command -v python)"; \
    PY_MINOR="$("${PY}" -c 'import sys; print(sys.version_info[1])')"; \
    IMG="${BASE_IMAGE:-}"; \
    SKIP_PIP=0; \
    if echo "${IMG}" | grep -qiE "paddle-metax|maca/paddle:"; then SKIP_PIP=1; fi; \
    if [ "${METAX_PADDLE_GPU}" != "1" ]; then \
      "${PY}" -m pip install --no-cache-dir "paddlepaddle>=2.6.0,<2.7.0" --default-timeout=600 --retries=20; \
    elif [ "${SKIP_PIP}" = "1" ]; then \
      echo "Metax: BASE_IMAGE is prebuilt (paddle-metax or maca/paddle); skipping pip install of paddlepaddle/paddle-metax-gpu."; \
      "${PY}" -c "import paddle; print('paddle ok', getattr(paddle, '__version__', '?'))"; \
    elif [ "${PY_MINOR}" -ge 12 ]; then \
      echo "ERROR: METAX_PADDLE_GPU=1 but Python is 3.${PY_MINOR}+. paddle-metax-gpu has no cp312+ wheels." >&2; \
      echo "Fix: use BASE_IMAGE=.../maca/paddle:...-py310-...-arm64|amd64 or .../paddle-metax:...-py310-..., OR set METAX_PADDLE_GPU=0." >&2; \
      exit 1; \
    elif [ "${PADDLE_METAX_CHANNEL}" = "stable" ]; then \
      "${PY}" -m pip install --no-cache-dir "paddlepaddle==${PADDLE_CPU_METAX_VER}" -i "${PADDLE_CPU_INDEX_STABLE}" \
        --default-timeout=600 --retries=20; \
      "${PY}" -m pip install --no-cache-dir "paddle-metax-gpu==${PADDLE_METAX_GPU_VER}" -i "${PADDLE_MACA_INDEX_STABLE}" \
        --default-timeout=600 --retries=20; \
    else \
      "${PY}" -m pip install --no-cache-dir --pre paddlepaddle -i "${PADDLE_CPU_INDEX_NIGHTLY}" \
        --default-timeout=600 --retries=20; \
      "${PY}" -m pip install --no-cache-dir --pre paddle-metax-gpu -i "${PADDLE_MACA_INDEX_NIGHTLY}" \
        --default-timeout=600 --retries=20; \
    fi

RUN PY="$(command -v python3.10 || command -v python3 || command -v python)" && \
    if [ -n "${PIP_INDEX_URL}" ]; then \
      "${PY}" -m pip install --no-cache-dir -i "${PIP_INDEX_URL}" -r /app/service/requirements-base.txt ; \
    else \
      "${PY}" -m pip install --no-cache-dir -r /app/service/requirements-base.txt ; \
    fi

RUN PY="$(command -v python3.10 || command -v python3 || command -v python)" && \
    if [ -n "${PIP_INDEX_URL}" ]; then \
      "${PY}" -m pip install --no-cache-dir -i "${PIP_INDEX_URL}" -r /app/service/requirements-paddleocr.txt ; \
    else \
      "${PY}" -m pip install --no-cache-dir -r /app/service/requirements-paddleocr.txt ; \
    fi

# 固定服务入口解释器，避免 py310/py3/conda 混用导致 CMD 找不到 uvicorn
RUN PY="$(command -v python3.10 || command -v python3 || command -v python)" && ln -sf "${PY}" /usr/local/bin/paddle-layout-python

COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh 2>/dev/null || true && chmod +x /entrypoint.sh

COPY service /app/service
WORKDIR /app/service

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/local/bin/paddle-layout-python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "75"]
