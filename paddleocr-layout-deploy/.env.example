# 与 mineru-deploy/.env.example 同风格：宿主机路径 + 端口 + 可选镜像源
PIP_INDEX_URL=

PADDLE_LAYOUT_PORT=8010
PADDLE_LAYOUT_CONTAINER_NAME=paddleocr-layout-api
PADDLE_LAYOUT_CPU_IMAGE=paddleocr-layout-api:py311-cpu
PADDLE_LAYOUT_NETWORK_NAME=paddle-layout-stack

# 模型与 IO 缓存（可离线预热至 models 目录）
PADDLE_LAYOUT_MODELS_HOST_PATH=./data/paddle_layout_models
PADDLE_LAYOUT_IO_HOST_PATH=./data/paddle_layout_io

PADDLE_LAYOUT_CPU_LIMIT=4.0
PADDLE_LAYOUT_MEM_LIMIT=16g
PADDLE_LAYOUT_MAX_UPLOAD_MB=32
PADDLE_LAYOUT_ENGINE_SEMVER=0.1.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GPU · 英伟达（docker compose -f docker-compose.yml -f docker-compose.gpu.nvidia.yml）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PADDLE_LAYOUT_GPU_NV_IMAGE=paddleocr-layout-api:cu118-gpu
# paddlepaddle-gpu 版本与飞桨 cu118 索引（见 Dockerfile.gpu.nvidia 内说明）
PADDLE_LAYOUT_NV_PADDLE_GPU_VERSION=2.6.2
PADDLE_LAYOUT_NV_WHEEL_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cu118/
# 与 mineru-deploy / vllm-deploy 习惯一致：可见 GPU；单卡示例 0
PADDLE_LAYOUT_NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GPU · 沐曦 Metax / MACA（docker compose -f docker-compose.yml -f docker-compose.gpu.mthreads.yml）
# 对齐 vllm-deploy：BASE_IMAGE、MX_VISIBLE_DEVICES、privileged + /dev 在 compose 中已写死策略，勿随意删减。
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PADDLE_LAYOUT_GPU_MT_IMAGE=paddleocr-layout-api:metax-gpu
# 与 app/app-deploy/docker-mx 及 vllm-deploy/.env.example 可保持同一基础镜像标签
PADDLE_LAYOUT_MT_BASE_IMAGE=cr.metax-tech.com/public-ai-release/maca/vllm-metax:0.17.0-maca.ai3.5.3.307-torch2.8-py312-kylinv11-amd64
# 1=安装 paddlepaddle（cpu 包）+ paddle-metax-gpu；0=镜像内仅 paddlepaddle 2.6 CPU（无沐曦 GPU 加速）
PADDLE_LAYOUT_METAX_PADDLE_GPU=1
PADDLE_LAYOUT_METAX_CPU_PADDLE_VER=3.3.0
PADDLE_LAYOUT_METAX_GPU_VER=3.3.0
MX_VISIBLE_DEVICES=0
