# 与 mineru-deploy/.env.example 同风格：宿主机路径 + 端口 + 可选镜像源
PIP_INDEX_URL=

PADDLE_LAYOUT_PORT=8010
PADDLE_LAYOUT_CONTAINER_NAME=paddleocr-layout-api
PADDLE_LAYOUT_CPU_IMAGE=paddleocr-layout-api:py311-cpu
# CPU 底镜像（Dockerfile.cpu 的 FROM）。默认 **DaoCloud 代理**（多数国内环境可直连，绕过 daemon 里失效的 hub-mirror.c.163.com）。
PADDLE_LAYOUT_CPU_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-bookworm
# 海外或已修正 /etc/docker/daemon.json 的 registry-mirrors 后，可改回官方 Hub：
# PADDLE_LAYOUT_CPU_BASE_IMAGE=python:3.11-bookworm
# 或贵司 Harbor：your-registry.example.com/library/python:3.11-bookworm
PADDLE_LAYOUT_NETWORK_NAME=paddle-layout-stack

# 模型与 IO 缓存（可离线预热至 models 目录）
PADDLE_LAYOUT_MODELS_HOST_PATH=./data/paddle_layout_models
PADDLE_LAYOUT_IO_HOST_PATH=./data/paddle_layout_io

PADDLE_LAYOUT_CPU_LIMIT=4.0
PADDLE_LAYOUT_MEM_LIMIT=16g
PADDLE_LAYOUT_MAX_UPLOAD_MB=32
PADDLE_LAYOUT_ENGINE_SEMVER=0.1.0
# 1/true：每页额外跑 PP-Structure 做表格（响应 `tables`）；0/false：仅行级 OCR
PADDLE_LAYOUT_ENABLE_TABLE_STRUCTURE=1
# Paddle 推理：IR 图优化 / MKLDNN。默认均为关闭（false），避免部分 CPU 在 IR 融合阶段 SIGILL（Illegal instruction）；现代 CPU 追求吞吐可设 true
# PADDLE_LAYOUT_OCR_IR_OPTIM=false
# PADDLE_LAYOUT_OCR_ENABLE_MKLDNN=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GPU · 英伟达（docker compose -f docker-compose.gpu.nvidia.yml）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PADDLE_LAYOUT_GPU_NV_IMAGE=paddleocr-layout-api:cu118-gpu
# paddlepaddle-gpu 版本与飞桨 cu118 索引（见 Dockerfile.gpu.nvidia 内说明）
PADDLE_LAYOUT_NV_PADDLE_GPU_VERSION=2.6.2
PADDLE_LAYOUT_NV_WHEEL_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cu118/
# 与 mineru-deploy / vllm-deploy 习惯一致：可见 GPU；单卡示例 0
PADDLE_LAYOUT_NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GPU · 沐曦 Metax / MACA（docker compose -f docker-compose.gpu.mthreads.yml）
# 曦思 N260 / 曦云 C 系列等：均走 MACA 栈 + paddle-metax-gpu（与飞桨文档「C500」示例为同一软件路径；卡型号由宿主机 MACA 识别）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PADDLE_LAYOUT_GPU_MT_IMAGE=paddleocr-layout-api:metax-gpu
# 默认：沐曦 **maca/paddle:2.6.0**（py310 + **麒麟 Kylin V11 + amd64**；镜像内已集成飞桨与 MACA；构建时跳过飞桨 pip）。
# ARM64 麒麟可覆盖为沐曦 **`…-kylinv10-arm64`** 等 tag（勿在 x86 上使用 arm64 tag）。
# 若改用 vllm-metax（常为 Python 3.12）：请设 PADDLE_LAYOUT_METAX_PADDLE_GPU=0。
PADDLE_LAYOUT_MT_BASE_IMAGE=cr.metax-tech.com/public-ai-release/maca/paddle:2.6.0-maca.ai3.7.0.6-py310-kylinv11-amd64
# 1=飞桨 CPU 包 + paddle-metax-gpu（沐曦）；0=仅 paddlepaddle 2.6 CPU（无沐曦 GPU 加速）
PADDLE_LAYOUT_METAX_PADDLE_GPU=1
# 沐曦飞桨 wheel：官方文档用 nightly + --pre；stable/maca 常无 paddle-metax-gpu，会报 No matching distribution
# nightly（默认）| stable（需 PADDLE_LAYOUT_METAX_* 版本与现场 wheel 一致，否则易失败）
PADDLE_LAYOUT_METAX_CHANNEL=nightly
# 仅 PADDLE_LAYOUT_METAX_CHANNEL=stable 时生效
PADDLE_LAYOUT_METAX_CPU_PADDLE_VER=3.3.0
PADDLE_LAYOUT_METAX_GPU_VER=3.3.0
MX_VISIBLE_DEVICES=0
# ━━ 麒麟下 LibreOffice（compose build.args，仅 Dockerfile.gpu.mthreads）━━━━━━━━
# 未设 PADDLE_LAYOUT_LO_REPO_URL 且 PADDLE_LAYOUT_LO_BUILTIN_CHINA_EPEL=1（默认）时，构建会复制内置阿里云 EPEL（见 docker/epel-china-el7/el8.repo）；与底镜像主版本不符时可设 BUILTIN=0 并改用自建 .repo。
PADDLE_LAYOUT_LO_BUILTIN_CHINA_EPEL=1
# PADDLE_LAYOUT_LO_REPO_URL=https://artifacts.example.com/yum/libreoffice.repo
PADDLE_LAYOUT_LO_YUM_PACKAGES=libreoffice-headless libreoffice-langpack-zh-Hans
# PADDLE_LAYOUT_LO_RPM_URLS=https://artifacts.example.com/rpms/libreoffice-core.rpm
PADDLE_LAYOUT_LO_YUM_NOGPGCHECK=0
