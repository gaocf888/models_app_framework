      "stream_live": true,
      "use_emit_tools": false
    },
    {
      "id": "l_events",
      "kind": "llm_section",
      "title": "二、泄爆/泄漏事件与履历",
      "source_item_ids": ["q1", "q2"],
      "outline": ["按时间或区域归纳", "无记录须说明"],
