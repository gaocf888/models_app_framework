      "allowed_outputs": ["paragraph", "table"],
      "use_emit_tools": true
    },
    {
      "id": "l_advice",
      "kind": "llm_section",
      "title": "四、处置与防控建议",
      "source_item_ids": ["q1", "q2", "q3", "q4", "q5", "q6"],
      "outline": ["立即", "短期", "持续跟踪"],
      "narrative_instruction": "按立即/短期/持续跟踪给出可执行建议。",
      "allowed_outputs": ["paragraph"],
      "use_emit_tools": false
    }
  ]
