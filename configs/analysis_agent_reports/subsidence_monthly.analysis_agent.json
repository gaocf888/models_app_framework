{
  "schema_version": 3,
  "title": "北京市地面沉降监测月报",
  "description": "V2 拼装：概况/平原/重点区叙述/典型双轴。GNSS 一期关闭。",
  "compose": [
    { "section": "cover", "params": { "cover_kind": "short" } },
    { "section": "monthly_overview" },
    { "section": "plain_monitoring" },
    { "section": "key_area" },
    { "section": "typical_curve" }
  ],
  "plan": {
    "items": [
      {
        "item_id": "q_compress",
        "executor": "python",
        "python_fn": "layer_compress",
        "mandatory": false,
        "dependency_ids": ["q_fcb_endpoints"],
        "purpose": "第一压缩层组，供典型曲线孔压方向"
      },
      {
        "item_id": "q_typical_fcb",
        "executor": "sql_template",
        "sql_file": "typical_series_fcb.sql",
        "mandatory": false,
        "dependency_ids": [],
        "purpose": "层位0日序列"
      },
      {
        "item_id": "q_typical_dxswj",
        "executor": "sql_template",
        "sql_file": "typical_series_dxswj.sql",
        "mandatory": false,
        "dependency_ids": [],
        "purpose": "水位井时序（dxswj 覆盖）"
      },
      {
        "item_id": "q_typical_qxz",
        "executor": "sql_template",
        "sql_file": "typical_series_qxz.sql",
        "mandatory": false,
        "dependency_ids": [],
        "purpose": "气象降水时序（qxz 覆盖）"
      },
      {
        "item_id": "q_typical_kxsylj",
        "executor": "sql_template",
        "sql_file": "typical_series_kxsylj.sql",
        "mandatory": false,
        "dependency_ids": [],
        "purpose": "孔压时序（kxsylj 覆盖）"
      },
      {
        "item_id": "q_typical",
        "executor": "python",
        "python_fn": "typical_curve",
        "mandatory": false,
        "dependency_ids": [
          "q_layer0",
          "q_typical_fcb",
          "q_typical_dxswj"
        ],
        "purpose": "择优双轴序列；GNSS 方向关闭"
      }
    ]
  }
}
