{
  "schema_version": 3,
  "title": "北京市地面沉降监测年报",
  "description": "年报套季报 compose；params.period_kind=year 仅影响封面措辞（period_label 由 period.py 给出「上年」）。",
  "compose": [
    { "section": "cover", "variant": "quarterly", "params": { "cover_kind": "quarterly", "period_kind": "year" } },
    { "section": "quarterly_preface" },
    { "section": "city_plain" },
    { "section": "district_results" },
    { "section": "layer_results" },
    { "section": "key_area", "variant": "with_table" },
    { "section": "conclusion" },
    { "section": "annex_ground" },
    { "section": "annex_layer" }
  ],
  "plan": {
    "items": [
      {
        "item_id": "q_area_rank",
        "executor": "python",
        "python_fn": "rank_by_area",
        "mandatory": false,
        "dependency_ids": ["q_layer0"],
        "purpose": "全市平原按行政区汇总层位0"
      },
      {
        "item_id": "q_compress",
        "executor": "python",
        "python_fn": "layer_compress",
        "mandatory": true,
        "dependency_ids": ["q_fcb_endpoints"],
        "purpose": "连续层间压缩"
      },
      {
        "item_id": "q_key_area",
        "executor": "python",
        "python_fn": "join_key_areas",
        "mandatory": false,
        "dependency_ids": ["q_layer0", "q_compress"],
        "purpose": "表4-1 重点区13站"
      }
    ]
  }
}
